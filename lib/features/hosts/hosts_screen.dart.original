// ─────────────────────────────────────────────────────────────────────────────
// BNG navigation logic
// For BNG host group only.
//
// Step 1: Check each host for a "HostGroup" / "hostgroup" tag whose VALUE
//         becomes its own BNG sub-menu entry.
//
// Step 2: If no such tag, call fetchItemPrototypes and read each prototype's
//         discoveryRule.name / discoveryRule.key to resolve the host into
//         one or more of the three BNG groups.
//
// Three groups displayed as Metro tiles:
//   System Health  = discoveries 1-5 (Chassis, CPU, Health, Subscriber, Memory)
//   SAP Interfaces = discovery 6 (BNG SAP DISCOVERY)
//   Port Details   = discovery 7 (BNG_Network_Statistics: NETWORK INTERFACE DISCOVERY)
// ─────────────────────────────────────────────────────────────────────────────
enum _BngGroup { systemHealth, sapInterfaces, portDetails }

extension _BngGroupX on _BngGroup {
  String get label {
    switch (this) {
      case _BngGroup.systemHealth:  return 'System Health';
      case _BngGroup.sapInterfaces: return 'SAP Interfaces';
      case _BngGroup.portDetails:   return 'Port Details';
    }
  }
  IconData get icon {
    switch (this) {
      case _BngGroup.systemHealth:  return Icons.monitor_heart_outlined;
      case _BngGroup.sapInterfaces: return Icons.hub_outlined;
      case _BngGroup.portDetails:   return Icons.settings_ethernet;
    }
  }
  Color get color {
    switch (this) {
      case _BngGroup.systemHealth:  return const Color(0xFF00ABA9);
      case _BngGroup.sapInterfaces: return const Color(0xFF6A00FF);
      case _BngGroup.portDetails:   return const Color(0xFF0078D7);
    }
  }
}

/// Maps a discoveryRule name+key to a BNG group. Returns null if unrecognised.
_BngGroup? _mapDiscoveryRule(String ruleName, String ruleKey) {
  final n = ruleName.toLowerCase().trim();
  if (n == 'bng sap discovery') return _BngGroup.sapInterfaces;
  if (n == 'bng_network_statsistics: network interface discovery' ||
      n == 'network interface discovery') {
    return _BngGroup.portDetails;
  }
  const sys = {
    'bng chassis component discovery',
    'bng cpu process discovery',
    'bng health discovery',
    'bng subscriber management',
    'bng memory pool discovery',
  };
  if (sys.contains(n)) return _BngGroup.systemHealth;
  return null;
}

Map<String, String> _ruleFromPrototype(dynamic p) {
  if (p is! Map) return const {};
  final rule = p['discoveryRule'] ??
      p['discoveryrule'] ??
      p['discovery_rule'] ??
      p['lldRule'] ??
      p['lld_rule'] ??
      p['discovery'] ??
      {};
  if (rule is! Map) return const {};
  final rname = (rule['name'] ?? '').toString();
  final rkey = (rule['key'] ?? rule['key_'] ?? '').toString();
  if (rname.isEmpty && rkey.isEmpty) return const {};
  return {'name': rname, 'key': rkey};
}

String _baseKey(String key) {
  final lower = key.toLowerCase().trim();
  final idx = lower.indexOf('[');
  return idx > 0 ? lower.substring(0, idx) : lower;
}

Set<_BngGroup> _groupsFromPrototypes(List<dynamic> prototypes) {
  final out = <_BngGroup>{};
  for (final p in prototypes) {
    final rule = _ruleFromPrototype(p);
    if (rule.isEmpty) continue;
    final g = _mapDiscoveryRule(rule['name'] ?? '', rule['key'] ?? '');
    if (g != null) out.add(g);
  }
  return out;
}

Map<_BngGroup, Set<String>> _keyBasesFromPrototypes(List<dynamic> prototypes) {
  final out = <_BngGroup, Set<String>>{};
  for (final p in prototypes) {
    if (p is! Map) continue;
    final rule = _ruleFromPrototype(p);
    if (rule.isEmpty) continue;
    final g = _mapDiscoveryRule(rule['name'] ?? '', rule['key'] ?? '');
    if (g == null) continue;
    final key = (p['key'] ?? p['key_'] ?? '').toString();
    if (key.isEmpty) continue;
    out.putIfAbsent(g, () => <String>{}).add(_baseKey(key));
  }
  return out;
}

Map<String, String> _ruleByKeyBaseFromPrototypes(List<dynamic> prototypes) {
  final out = <String, String>{};
  for (final p in prototypes) {
    if (p is! Map) continue;
    final rule = _ruleFromPrototype(p);
    if (rule.isEmpty) continue;
    final name = (rule['name'] ?? '').toString().trim();
    if (name.isEmpty) continue;
    final key = (p['key'] ?? p['key_'] ?? '').toString();
    if (key.isEmpty) continue;
    out[_baseKey(key)] = name;
  }
  return out;
}

// ─────────────────────────────────────────────────────────────────────────────
// Per-host BNG metadata
// ─────────────────────────────────────────────────────────────────────────────
class _BngHostMeta {
  final Set<_BngGroup> groups;
  final String? tagGroup;
  final Map<_BngGroup, Set<String>> keyBases;
  final Map<String, String> ruleByKeyBase;
  final bool loaded;
  const _BngHostMeta(this.groups, {
    this.tagGroup,
    this.keyBases = const {},
    this.ruleByKeyBase = const {},
    this.loaded = false,
  });

  factory _BngHostMeta.fromTagValue(String tagValue) {
    return _BngHostMeta({}, tagGroup: tagValue.trim(), loaded: true);
  }

  factory _BngHostMeta.fromPrototypes(List<dynamic> protos) =>
      _BngHostMeta(
        _groupsFromPrototypes(protos),
        keyBases: _keyBasesFromPrototypes(protos),
        ruleByKeyBase: _ruleByKeyBaseFromPrototypes(protos),
        loaded: true,
      );
}

// ─────────────────────────────────────────────────────────────────────────────
// Metro color palette
// ─────────────────────────────────────────────────────────────────────────────
class _MC {
  static const blue    = Color(0xFF0078D7);
  static const cobalt  = Color(0xFF0050EF);
  static const teal    = Color(0xFF00ABA9);
  static const emerald = Color(0xFF008A00);
  static const cyan    = Color(0xFF1BA1E2);
  static const amber   = Color(0xFFF0A30A);

  static const List<Color> _pal = [
    teal, blue, Color(0xFF6A00FF), Color(0xFFD80073), Color(0xFFE51400),
    Color(0xFFFA6800), amber, Color(0xFFA4C400), Color(0xFF60A917),
    emerald, cyan, cobalt, Color(0xFF647687), Color(0xFF76608A),
  ];

  static Color forIndex(int i) => _pal[i % _pal.length];
  static Color forGroupName(String name) {
    final g = name.toLowerCase();
    if (g.contains('bng') && !g.contains('icmp')) return blue;
    if (g.contains('pe'))                           return cobalt;
    if (g.contains('icmp'))                         return teal;
    if (g.contains('sr'))                           return emerald;
    if (g.contains('tip') || g.contains('olt'))    return cyan;
    if (g.contains('monitor') || g.contains('script')) return amber;
    return forIndex(name.hashCode.abs());
  }
}

