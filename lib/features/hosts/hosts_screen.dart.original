/// Breadcrumb item + chip
class _Crumb {
  final String label; final IconData icon;
  final Color? color; final VoidCallback? onTap; final bool active;
  const _Crumb({required this.label, required this.icon,
    this.color, this.onTap, this.active = false});
}

class _CrumbChip extends StatelessWidget {
  final _Crumb item;
  const _CrumbChip({required this.item});
  @override
  Widget build(BuildContext context) {
    final c = item.color ?? ZbxPalette.rxBlue;
    return GestureDetector(
      onTap: item.onTap,
      child: AnimatedContainer(
        duration: const Duration(milliseconds: 180),
        padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 5),
        color: item.active ? c : Colors.transparent,
        child: Row(mainAxisSize: MainAxisSize.min, children: [
          Icon(item.icon, size: 11,
              color: item.active ? Colors.white : ZbxT.textSec(context)),
          const SizedBox(width: 5),
          Text(item.label, maxLines: 1, overflow: TextOverflow.ellipsis,
            style: TextStyle(fontSize: 11,
              fontWeight: item.active ? FontWeight.w700 : FontWeight.w500,
              color: item.active ? Colors.white : ZbxT.textSec(context),
              letterSpacing: item.active ? 0.3 : 0)),
          if (item.onTap != null) ...[
            const SizedBox(width: 4),
            Icon(Icons.close, size: 10,
              color: item.active
                  ? Colors.white.withValues(alpha: 0.8)
                  : ZbxT.textSec(context).withValues(alpha: 0.6)),
          ],
        ]),
      ),
    );
  }
}

// ─────────────────────────────────────────────────────────────────────────────
void _unawaited(Future<void> f) => f.catchError((_) {});

// ─────────────────────────────────────────────────────────────────────────────
// MAIN SCREEN
// ─────────────────────────────────────────────────────────────────────────────
class HostsScreen extends StatefulWidget {
  final String pushStatus;
  final String searchQuery;
  final String? initialGroupId;
  final String? initialGroupName;
  final VoidCallback? onExit;

  const HostsScreen({
    super.key,
    required this.pushStatus,
    required this.searchQuery,
    this.initialGroupId,
    this.initialGroupName,
    this.onExit,
  });

  @override
  State<HostsScreen> createState() => _HostsScreenState();
}

class _HostsScreenState extends State<HostsScreen> {
  // ── Core ──────────────────────────────────────────────────────────────────
  List<dynamic> _hostGroups = [];
  bool   _loading = true;
  String _error   = '';

  final Map<String, List<dynamic>> _hostsForGroup   = {};
  final Map<String, bool>          _loadingHosts    = {};

  final Map<String, List<dynamic>>              _itemsForHost          = {};
  final Map<String, Map<String, List<dynamic>>> _entityMapForHost      = {};
  final Map<String, Map<String, List<dynamic>>> _normalEntitiesForHost = {};
  final Map<String, Map<String, List<dynamic>>> _sapEntitiesForHost    = {};
  final Map<String, bool>                       _loadingItems          = {};
  final Map<String, String>                     _hostMetaBlob          = {};
  final Map<String, bool>                       _sectionExpanded       = {};

  // ── BNG state ──────────────────────────────────────────────────────────────
  final Map<String, _BngHostMeta> _bngMeta    = {};
  final Set<String>               _bngLoading = {};

  // BNG navigation levels
  String?   _expandedBngDevice;   // Level 1: BNG device name (from "bng" tag)
  _BngGroup? _expandedBngGroup;   // Level 2: discovery category
  String?   _expandedBngTagGroup; // Level 2: Hostgroup tag category

  // ── General expansion ──────────────────────────────────────────────────────
  String? _expandedGroupId;
  String? _expandedGroupName;
  String? _expandedHostId;
  String? _expandedHostName;

  int _hostLoadSeq = 0;
  final Map<String, int> _hostSeq = {};

  // ── Problem counts ─────────────────────────────────────────────────────────
  Map<String, int> _probByHost  = {};
  Map<String, int> _probByGroup = {};

  bool   _showRail  = false;
  Timer? _railTimer;

  // ── Life-cycle ─────────────────────────────────────────────────────────────
  @override
  void initState() {
    super.initState();
    _loadFromCache();
    _buildProbCounts();
    AppCache.instance.addListener(_onCache);
  }

  @override
  void dispose() {
    _railTimer?.cancel();
    AppCache.instance.removeListener(_onCache);
    super.dispose();
  }

  void _onCache() {
    if (!mounted) return;
    setState(() { _hostGroups = AppCache.instance.hostGroups; _buildProbCounts(); });
  }

  void _buildProbCounts() {
    final hm = <String, dynamic>{};
    for (final h in AppCache.instance.hosts) {
      final id = h['hostid']?.toString();
      if (id != null) hm[id] = h;
    }
    final byH = <String, int>{};
    final byG = <String, int>{};
    for (final p in AppCache.instance.problems) {
      final th = p['hosts'];
      if (th is! List) continue;
      for (final h in th) {
        final hid = h['hostid']?.toString();
        if (hid == null) continue;
        byH[hid] = (byH[hid] ?? 0) + 1;
        final host = hm[hid];
        if (host == null) continue;
        final gs = host['groups'] ?? host['hostgroups'];
        if (gs is List) {
          for (final g in gs) {
            final gn = (g['name'] ?? '').toString();
            if (gn.isNotEmpty) byG[gn] = (byG[gn] ?? 0) + 1;
          }
        }
      }
    }
    _probByHost = byH;
    _probByGroup = byG;
  }

  void _loadFromCache() {
    final cache = AppCache.instance;
    if (cache.hostGroups.isNotEmpty) {
      setState(() { _hostGroups = cache.hostGroups; _loading = false; _error = cache.loadError; });
    }
    if (!cache.isLoading) {
      cache.refresh().then((_) {
        if (!mounted) return;
        setState(() {
          _hostGroups = AppCache.instance.hostGroups;
          _loading = false; _error = AppCache.instance.loadError;
          _buildProbCounts();
        });
      }).catchError((_) {});
    } else {
      setState(() => _loading = false);
    }
  }

  // ── Group toggle ───────────────────────────────────────────────────────────
  Future<void> _toggleGroup(String gid, String gname) async {
    if (_expandedGroupId == gid) {
      setState(() {
        _expandedGroupId = null; _expandedGroupName = null;
        _expandedHostId  = null; _expandedHostName  = null;
        _expandedBngDevice = null; _expandedBngGroup = null; _expandedBngTagGroup = null;
      });
      return;
    }
    setState(() {
      _expandedGroupId = gid; _expandedGroupName = gname;
      _expandedHostId  = null; _expandedHostName  = null;
      _expandedBngDevice = null; _expandedBngGroup = null; _expandedBngTagGroup = null;
    });
    if (_hostsForGroup.containsKey(gid)) {
      if (_isBng(gname)) _warmBng(_hostsForGroup[gid]!);
      return;
    }
    setState(() => _loadingHosts[gid] = true);
    try {
      final hosts = await ApiClient.fetchHosts(groupId: gid);
      if (!mounted) return;
      setState(() { _hostsForGroup[gid] = hosts; _loadingHosts[gid] = false; });
      if (_isBng(gname)) _warmBng(hosts);
    } catch (e) {
      if (!mounted) return;
      setState(() { _loadingHosts[gid] = false; _error = 'Failed: $e'; });
    }
  }

  // ── Host toggle (non-BNG or BNG item detail) ───────────────────────────────
  Future<void> _toggleHost(dynamic host) async {
    final hid   = (host['hostid'] ?? '').toString();
    final hname = (host['name'] ?? host['host'] ?? 'Host').toString();
    if (_expandedHostId == hid) {
      setState(() { _expandedHostId = null; _expandedHostName = null; });
      return;
    }
    setState(() { _expandedHostId = hid; _expandedHostName = hname; });
    _showRailTemp();
    if (_entityMapForHost.containsKey(hid)) return;

    final seq = ++_hostLoadSeq;
    _hostSeq[hid] = seq;
    setState(() => _loadingItems[hid] = true);

    try {
      List<dynamic> items = [];
      try { items = await ApiClient.fetchItemsMetadata(hid, cacheOnly: true); } catch (_) {}
      if (items.isNotEmpty && mounted && _hostSeq[hid] == seq) _processItems(hid, items);

      final isNet = _isNetworkGroup(_expandedGroupName);
      List<dynamic> all;
      if (isNet) {
        all = await ApiClient.fetchItems(hid);
        if (all.isEmpty) all = _wrapLld(await ApiClient.fetchLldRules(hid));
      } else {
        try { all = await ApiClient.fetchItems(hid); } catch (_) { all = []; }
        if (all.isEmpty) all = _wrapLld(await ApiClient.fetchLldRules(hid));
      }

      if (!mounted || _hostSeq[hid] != seq) return;
      _processItems(hid, all);
      setState(() => _loadingItems[hid] = false);
    } catch (_) {
      if (!mounted) return;
      setState(() { _loadingItems[hid] = false; _entityMapForHost.putIfAbsent(hid, () => {}); });
    }
  }

  void _showRailTemp() {
    _railTimer?.cancel();
    setState(() => _showRail = true);
    _railTimer = Timer(const Duration(seconds: 3), () {
      if (mounted) setState(() => _showRail = false);
    });
  }

  void _processItems(String hid, List<dynamic> items) {
    final isSr = _isBngSrHost(hid);
    final nm = <String, List<dynamic>>{};
    final sm = <String, List<dynamic>>{};
    final all = <String, List<dynamic>>{};
    for (final item in items) {
      final entity = entityName(item);
      if (isSr && _isSap(item)) {
        sm.putIfAbsent(_sapEntity(item, entity), () => []).add(item);
      } else {
        nm.putIfAbsent(entity, () => []).add(item);
      }
      all.putIfAbsent(entity, () => []).add(item);
    }
    final sb = StringBuffer();
    for (final i in items) sb.write(' ${i['name'] ?? ''} ${i['key_'] ?? ''}');
    _hostMetaBlob[hid] = sb.toString();
    if (mounted) setState(() {
      _itemsForHost[hid]          = items;
      _sapEntitiesForHost[hid]    = sm;
      _normalEntitiesForHost[hid] = nm;
      _entityMapForHost[hid]      = all;
    });
  }

  Future<void> _prefetchHostItems(String hid) async {
    if (_itemsForHost.containsKey(hid) || _loadingItems[hid] == true) return;
    _loadingItems[hid] = true;
    try {
      List<dynamic> items = [];
      try {
        items = await ApiClient.fetchItemsMetadata(hid, cacheOnly: true);
      } catch (_) {}
      if (items.isNotEmpty) _processItems(hid, items);

      final all = await ApiClient.fetchItems(hid);
      if (all.isNotEmpty) _processItems(hid, all);
    } catch (_) {
      // Best-effort prefetch.
    } finally {
      _loadingItems[hid] = false;
    }
  }

  List<dynamic> _itemsForBngGroup(String hid, _BngGroup group) {
    final meta = _bngMeta[hid];
    if (meta == null) return const [];
    final bases = meta.keyBases[group] ?? const <String>{};
    if (bases.isEmpty) return const [];
    final items = _itemsForHost[hid] ?? const <dynamic>[];
    return items.where((i) {
      final key = (i['key_'] ?? '').toString();
      if (key.isEmpty) return false;
      return bases.contains(_baseKey(key));
    }).toList();
  }

  List<dynamic> _filterHostsForGroupWithItems(
    List<dynamic> hosts,
    _BngGroup group,
  ) {
    final out = <dynamic>[];
    for (final h in hosts) {
      final hid = (h['hostid'] ?? '').toString();
      if (hid.isEmpty) continue;
      final meta = _bngMeta[hid];
      if (meta == null || !meta.loaded) continue;
      if (meta.tagGroup != null && meta.tagGroup!.isNotEmpty) continue;
      if (!meta.groups.contains(group)) continue;

      final hasItemsLoaded = _itemsForHost.containsKey(hid);
      if (!hasItemsLoaded) {
        _unawaited(_prefetchHostItems(hid));
        out.add(h);
        continue;
      }
      final items = _itemsForBngGroup(hid, group);
      if (items.isEmpty) continue;
      out.add(h);
    }
    return out;
  }

  // ── BNG meta warming ───────────────────────────────────────────────────────
  void _warmBng(List<dynamic> hosts) {
    for (final h in hosts) {
      final hid = (h['hostid'] ?? '').toString();
      if (hid.isEmpty || _bngMeta.containsKey(hid) || _bngLoading.contains(hid)) continue;
      _bngLoading.add(hid);

      // Step 1: HostGroup tag
      final tagVal = _tagValue(h, const [
        'hostgroup', 'hostgroup type', 'hostgroup_type', 'host group', 'HostGroup',
      ]);
      if (tagVal.isNotEmpty) {
        final meta = _BngHostMeta.fromTagValue(tagVal);
        _bngLoading.remove(hid);
        if (mounted) setState(() => _bngMeta[hid] = meta);
        debugPrint('[BNG] $hid → tag "$tagVal" → ${meta.groups}');
        continue;
      }

      // Step 2: itemprototypes (async)
      _unawaited(_loadBngFromProtos(hid));
    }
  }

  Future<void> _loadBngFromProtos(String hid) async {
    try {
      // Local cache
      final saved = await LocalStore.readMap('bng:discovery:$hid');
      final cachedList = (saved?['categories'] is List)
          ? List<String>.from((saved!['categories'] as List).map((e) => e.toString()))
          : <String>[];
      final cachedKb = saved?['key_bases'];
      final kbMap = <_BngGroup, Set<String>>{};
      if (cachedKb is Map) {
        for (final entry in cachedKb.entries) {
          final label = entry.key.toString();
          final group = _BngGroup.values.firstWhere(
            (g) => g.label == label,
            orElse: () => _BngGroup.systemHealth,
          );
          final list = entry.value is List
              ? List<String>.from((entry.value as List).map((e) => e.toString()))
              : <String>[];
          if (list.isNotEmpty) kbMap[group] = list.toSet();
        }
      }
      final cachedRules = saved?['rule_by_key_base'];
      final ruleMap = <String, String>{};
      if (cachedRules is Map) {
        for (final entry in cachedRules.entries) {
          final k = entry.key.toString();
          final v = entry.value?.toString() ?? '';
          if (k.isNotEmpty && v.isNotEmpty) ruleMap[k] = v;
        }
      }
      if (cachedList.isNotEmpty && kbMap.isNotEmpty) {
        final groups = cachedList.map((l) {
          for (final g in _BngGroup.values) { if (g.label == l) return g; }
          return null;
        }).whereType<_BngGroup>().toSet();
        _bngLoading.remove(hid);
        if (mounted) {
          setState(() => _bngMeta[hid] = _BngHostMeta(
            groups, keyBases: kbMap, ruleByKeyBase: ruleMap, loaded: true));
        }
        return;
      }

      // Network
      var protos = await ApiClient.fetchItemPrototypes(hid, cacheOnly: true);
      if (protos.isEmpty) protos = await ApiClient.fetchItemPrototypes(hid);
      final meta = _BngHostMeta.fromPrototypes(protos);
      debugPrint('[BNG] $hid itemprotos=${protos.length} → ${meta.groups}');

      if (meta.groups.isNotEmpty) {
        await LocalStore.writeMap('bng:discovery:$hid', <String, dynamic>{
          'categories': meta.groups.map((g) => g.label).toList()..sort(),
          'key_bases': meta.keyBases.map((g, v) => MapEntry(g.label, v.toList()..sort())),
          'rule_by_key_base': meta.ruleByKeyBase,
          'updated_at': DateTime.now().toIso8601String(),
        });
      }
      _bngLoading.remove(hid);
      if (mounted) setState(() => _bngMeta[hid] = meta);
    } catch (e) {
      debugPrint('[BNG] $hid error: $e');
      _bngLoading.remove(hid);
      if (mounted) setState(() => _bngMeta[hid] = _BngHostMeta({}, loaded: true));
    }
  }

  // ── Cache clear ────────────────────────────────────────────────────────────
  Future<void> _clearCache() async {
    final n = await LocalStore.clearByPrefix(const ['meta:', 'bng:']);
    _bngMeta.clear(); _bngLoading.clear();
    if (!mounted) return;
    setState(() { _expandedBngDevice = null; _expandedBngGroup = null; _expandedBngTagGroup = null; });
    await AppCache.instance.load(force: true);
    if (!mounted) return;
    ScaffoldMessenger.of(context).showSnackBar(SnackBar(
      content: Text('Cleared $n cached entries.'),
      duration: const Duration(seconds: 2),
    ));
  }

  // ── Navigation ─────────────────────────────────────────────────────────────
  void _openIf({
    required String hid, required String hname, required String hip,
    required String ifName, required List<dynamic> items,
    required List<String> order, required Map<String, List<dynamic>> map,
    bool isSap = false,
  }) {
    Navigator.of(context).push(MaterialPageRoute(
      builder: (_) => InterfaceDashboardScreen(
        hostId: hid, hostName: hname, hostIp: hip,
        interfaceName: ifName, isSap: isSap,
        preloadedItems: items, interfaceOrder: order, interfaceItemsByName: map,
      ),
    ));
  }

  // ── Helpers ────────────────────────────────────────────────────────────────
  bool _isBng(String? n)         { final g = (n ?? '').toLowerCase(); return g.contains('bng') && !g.contains('icmp'); }
  bool _isIcmp(String? n)        { final g = (n ?? '').toLowerCase(); return g.contains('icmp') || g.contains('sr') || g.contains('tip') || g.contains('olt'); }
  bool _isNetworkGroup(String? n){ final g = (n ?? '').toLowerCase(); if (g.contains('bng') && !g.contains('icmp')) return true; if (g.contains('pe')) return true; if (g.contains('icmp') || g.contains('sr') || g.contains('tip') || g.contains('olt') || g.contains('monitor') || g.contains('script')) return false; return true; }
  bool _isPingTag(String tag)    { final g = tag.toLowerCase(); return g.contains('ping'); }

  String _tagValue(dynamic host, List<String> keys) {
    final tags = host['tags'];
    if (tags is! List) return '';
    final wanted = keys.map((k) => k.toLowerCase().trim()).toSet();
    for (final t in tags) {
      final k = (t['tag'] ?? '').toString().toLowerCase().trim();
      final v = (t['value'] ?? '').toString().trim();
      if (wanted.contains(k) && v.isNotEmpty) return v;
    }
    return '';
  }

  String _bngDeviceName(dynamic host) {
    final v = _tagValue(host, const ['bng', 'bng_name', 'bng name', 'BNG']);
    return v.isNotEmpty ? v : (host['name'] ?? host['host'] ?? 'Unknown BNG').toString();
  }

  bool _isBngSrHost(String hid) {
    final host = AppCache.instance.hosts.firstWhere(
      (h) => (h['hostid'] ?? '').toString() == hid, orElse: () => null);
    if (host == null) return false;
    final n = (host['name'] ?? host['host'] ?? '').toString().toLowerCase();
    return n.contains('bng') && n.contains('sr');
  }

  bool _isSap(dynamic item) {
    final key = (item['key_'] ?? '').toString().toLowerCase();
    final hay = '$key ${(item['name'] ?? '').toString().toLowerCase()}';
    if (hay.contains('sapid') || hay.contains('sap[') || hay.contains(' sap ')) return true;
    if (RegExp(r'sap\.if\.\w+\[').hasMatch(key)) return true;
    if (RegExp(r'(^|[^a-z])sap([^a-z]|$)').hasMatch(hay)) return true;
    return false;
  }

  String _sapEntity(dynamic item, String fb) {
    final key = (item['key_'] ?? '').toString();
    final m = RegExp(r'sap\.if\.\w+\[([^\]]+)\]', caseSensitive: false).firstMatch(key);
    if (m != null) { final s = m.group(1)?.trim() ?? ''; if (s.isNotEmpty) return s; }
    final full = RegExp(r'\d+/\d+/c\d+/\d+:\d+\.\d+', caseSensitive: false).firstMatch('$key ${item['name'] ?? ''}');
    return full != null ? full.group(0)! : fb;
  }

  List<dynamic> _wrapLld(List<dynamic> rules) => rules.map((r) => {
    'itemid': 'lld-${r['itemid']}', 'name': r['name'] ?? 'LLD Rule',
    'key_': r['key_'] ?? '', 'lastvalue': '', 'value_type': '4',
    'units': '', 'lastclock': '', '_is_lld_rule': true,
  }).toList();

  // ── Search ─────────────────────────────────────────────────────────────────
  bool _matches(String text) {
    final q = widget.searchQuery.toLowerCase().trim();
    if (q.isEmpty) return true;
    final hay = text.toLowerCase();
    return q.split(RegExp(r'\s+')).where((t) => t.isNotEmpty).every((t) => hay.contains(t));
  }

  List<dynamic> _filteredGroups() {
    final gs = _hostGroups.where((g) {
      final name = (g['name'] ?? '').toString();
      final id   = (g['groupid'] ?? '').toString();
      final hosts = AppCache.instance.hosts.where((h) {
        final gn = (h['groups'] ?? h['hostgroups']) ?? [];
        return gn is List && gn.any((gr) => (gr['name'] ?? '') == name);
      });
      final sb = StringBuffer('$name $id');
      for (final h in hosts) {
        sb.write(' ${h['name'] ?? h['host'] ?? ''} ${extractIp(h)}');
        final meta = _hostMetaBlob[(h['hostid'] ?? '').toString()];
        if (meta != null) sb.write(' $meta');
      }
      return _matches(sb.toString());
    }).toList();
    gs.sort((a, b) => (a['name'] ?? '').toString().compareTo((b['name'] ?? '').toString()));
    return gs;
  }

  List<dynamic> _hostsIn(String gid, String gname) {
    final c = _hostsForGroup[gid];
    if (c != null) return c;
    return AppCache.instance.hosts.where((h) {
      final gl = h['groups'] ?? h['hostgroups'];
      if (gl is! List) return false;
      return gl.any((g) => (g['name'] ?? '').toString() == gname);
    }).toList();
  }

  // ══════════════════════════════════════════════════════════════════════════
  // BUILD
  // ══════════════════════════════════════════════════════════════════════════
  @override
  Widget build(BuildContext context) {
    if (_loading) return Center(child: CircularProgressIndicator(color: ZbxPalette.rxBlue, strokeWidth: 2));

    return PopScope(
      canPop: false,
      onPopInvokedWithResult: (didPop, _) async {
        if (didPop) return;
        if (_expandedBngGroup  != null) { setState(() => _expandedBngGroup  = null); return; }
        if (_expandedBngTagGroup != null) { setState(() => _expandedBngTagGroup = null); return; }
        if (_expandedBngDevice != null) { setState(() { _expandedBngDevice = null; _expandedBngGroup = null; _expandedBngTagGroup = null; }); return; }
        if (_expandedHostId    != null) { setState(() { _expandedHostId = null; _expandedHostName = null; }); return; }
        if (_expandedGroupId   != null) { setState(() { _expandedGroupId = null; _expandedGroupName = null; }); return; }
        widget.onExit?.call();
      },
      child: RefreshIndicator(
        onRefresh: () async => _loadFromCache(),
        color: ZbxPalette.rxBlue, backgroundColor: ZbxT.card(context),
        child: Column(children: [
          _buildBreadcrumb(),
          if (_error.isNotEmpty)
            Container(
              width: double.infinity,
              margin: const EdgeInsets.fromLTRB(0, 0, 0, 0),
              padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 8),
              color: ZbxPalette.downRed,
              child: Text(_error, style: const TextStyle(fontSize: 11, color: Colors.white,
                  fontWeight: FontWeight.w600))),
          Expanded(child: widget.searchQuery.trim().isNotEmpty ? _buildSearch() : _buildFlow()),
        ]),
      ),
    );
  }

  // ── Breadcrumb ─────────────────────────────────────────────────────────────
  Widget _buildBreadcrumb() {
    final parts = <_Crumb>[
      _Crumb(label: 'Groups', icon: Icons.grid_view,
        onTap: _expandedGroupId != null ? () => setState(() {
          _expandedGroupId = null; _expandedGroupName = null;
          _expandedHostId  = null; _expandedHostName  = null;
          _expandedBngDevice = null; _expandedBngGroup = null; _expandedBngTagGroup = null;
        }) : null,
        active: _expandedGroupId == null),
    ];
    if (_expandedGroupName != null) {
      final c = _MC.forGroupName(_expandedGroupName!);
      parts.add(_Crumb(label: _expandedGroupName!, icon: Icons.folder, color: c,
        onTap: (_expandedHostId != null || _expandedBngDevice != null) ? () => setState(() {
          _expandedHostId    = null; _expandedHostName   = null;
          _expandedBngDevice = null; _expandedBngGroup   = null; _expandedBngTagGroup = null;
        }) : null,
        active: _expandedHostId == null && _expandedBngDevice == null));
    }
    if (_expandedBngDevice != null) {
      final c = _MC.forGroupName(_expandedGroupName ?? '');
      parts.add(_Crumb(label: _expandedBngDevice!, icon: Icons.router, color: c,
        onTap: (_expandedBngGroup != null || _expandedBngTagGroup != null)
            ? () => setState(() { _expandedBngGroup = null; _expandedBngTagGroup = null; })
            : null,
        active: _expandedBngGroup == null && _expandedBngTagGroup == null));
    }
    if (_expandedBngGroup != null) {
      parts.add(_Crumb(label: _expandedBngGroup!.label, icon: _expandedBngGroup!.icon,
        color: _expandedBngGroup!.color, active: true));
    }
    if (_expandedBngTagGroup != null) {
      parts.add(_Crumb(label: _expandedBngTagGroup!, icon: Icons.label_outline,
        color: ZbxPalette.rxBlue, active: true));
    }
    if (_expandedHostName != null && _expandedBngDevice == null) {
      final c = _MC.forGroupName(_expandedGroupName ?? '');
      parts.add(_Crumb(label: _expandedHostName!, icon: Icons.dns,
        color: c.withValues(alpha: 0.75), active: true));
    }

    return Container(
      height: 44, color: ZbxT.card(context),
      child: Row(children: [
        const SizedBox(width: 12),
        Expanded(child: SingleChildScrollView(
          scrollDirection: Axis.horizontal,
          child: Row(
            children: parts.asMap().entries.expand((e) {
              final ws = <Widget>[_CrumbChip(item: e.value)];
              if (e.key < parts.length - 1) ws.add(Padding(
                padding: const EdgeInsets.symmetric(horizontal: 2),
                child: Icon(Icons.chevron_right, size: 14, color: ZbxT.textSec(context))));
              return ws;
            }).toList(),
          ),
        )),
        Container(width: 1, height: 28, color: ZbxT.textSec(context).withValues(alpha: 0.15)),
        IconButton(
          tooltip: 'Clear discovery cache',
          onPressed: _clearCache,
          icon: Icon(Icons.delete_sweep, size: 18, color: ZbxT.textSec(context))),
        const SizedBox(width: 4),
      ]),
    );
  }

  // ── Flow dispatcher ────────────────────────────────────────────────────────
  Widget _buildFlow() {
    final groups = _filteredGroups();
    if (groups.isEmpty) {
      return Center(child: Column(mainAxisSize: MainAxisSize.min, children: [
        Icon(Icons.folder_off_outlined, size: 48,
            color: ZbxT.textSec(context).withValues(alpha: 0.35)),
        const SizedBox(height: 14),
        Text('NO HOST GROUPS', style: TextStyle(fontSize: 12, fontWeight: FontWeight.w700,
            color: ZbxT.textSec(context), letterSpacing: 1.0)),
      ]));
    }
    if (_expandedGroupId == null) return _buildGroupList(groups);

    final gid    = _expandedGroupId!;
    final gname  = _expandedGroupName ?? '';
    final gcolor = _MC.forGroupName(gname);

    if (_isBng(gname)) return _buildBngFlow(gid, gname, gcolor);
    if (_expandedHostId == null) return _buildHostList(gid, gname, gcolor, asRail: false);
    return _buildHostDetail(gid, gname, gcolor);
  }

  // ── Group list ─────────────────────────────────────────────────────────────
  Widget _buildGroupList(List<dynamic> groups) {
    return ListView.builder(
      padding: const EdgeInsets.fromLTRB(0, 6, 0, 40),
      itemCount: groups.length,
      itemBuilder: (_, i) {
        final g      = groups[i];
        final gid    = (g['groupid'] ?? '').toString();
        final gname  = (g['name'] ?? '').toString();
        final color  = _MC.forGroupName(gname);
        final probs  = _probByGroup[gname] ?? 0;
        return _ListTileCard(
          icon: Icons.folder_outlined, color: color, title: gname,
          subtitle: null, alertCount: probs > 0 ? probs : null,
          onTap: () => _toggleGroup(gid, gname),
        );
      },
    );
  }

  // ══════════════════════════════════════════════════════════════════════════
  // BNG FLOW
  // ══════════════════════════════════════════════════════════════════════════
  Widget _buildBngFlow(String gid, String gname, Color gc) {
    final allHosts = _hostsIn(gid, gname);
    final isLoading = _loadingHosts[gid] == true;

    if (isLoading && allHosts.isEmpty) {
      return Center(child: Row(mainAxisSize: MainAxisSize.min, children: [
        SizedBox(width: 14, height: 14, child: CircularProgressIndicator(strokeWidth: 1.8, color: gc)),
        const SizedBox(width: 8),
        Text('Loading hosts…', style: TextStyle(fontSize: 11, color: gc)),
      ]));
    }

    // Level 1: BNG device name list
    if (_expandedBngDevice == null) return _buildBngDeviceList(allHosts, gc);

    final device      = _expandedBngDevice!;
    final deviceHosts = allHosts.where((h) => _bngDeviceName(h) == device).toList();

    // Level 2: Category group tiles
    if (_expandedBngGroup == null && _expandedBngTagGroup == null) {
      return _buildBngGroupTiles(device, deviceHosts, gc);
    }

    if (_expandedBngTagGroup != null) {
      final tag = _expandedBngTagGroup!;
      final tagHosts = deviceHosts.where((h) {
        final hid = (h['hostid'] ?? '').toString();
        final meta = _bngMeta[hid];
        if (meta == null || !meta.loaded) return false;
        if (tag == 'Unclassified') {
          return (meta.tagGroup == null || meta.tagGroup!.isEmpty) &&
              meta.groups.isEmpty;
        }
        return meta.tagGroup == tag;
      }).toList();

      if (_isPingTag(tag)) return _buildBngPingHostList(tagHosts, tag, gc);
      if (_expandedHostId == null) return _buildBngTagHostList(tagHosts, tag, gc);
      return _buildHostDetail(gid, gname, gc);
    }

    final selGroup  = _expandedBngGroup!;

    if (selGroup == _BngGroup.sapInterfaces) {
      return _buildBngSapItems(deviceHosts, gc);
    }

    final catHosts = _filterHostsForGroupWithItems(deviceHosts, selGroup);

    // Level 3: Host list for category
    if (_expandedHostId == null) return _buildBngCatHostList(catHosts, selGroup);

    // Level 4: Host detail (item view)
    if (selGroup == _BngGroup.systemHealth) {
      return _buildBngHostItemsDetail(catHosts, selGroup, gc);
    }
    if (selGroup == _BngGroup.portDetails) {
      return _buildBngPortDetailHostDetail(catHosts, gc);
    }
    return _buildHostDetail(gid, gname, gc);
  }

  // BNG Level 1: device name list
  Widget _buildBngDeviceList(List<dynamic> hosts, Color gc) {
    final byDevice = <String, List<dynamic>>{};
    for (final h in hosts) byDevice.putIfAbsent(_bngDeviceName(h), () => []).add(h);
    final names = byDevice.keys.toList()..sort();

    if (names.isEmpty) return Center(child: Text('No BNG devices found',
        style: TextStyle(color: ZbxT.textSec(context))));

    // Kick off BNG meta loading for all hosts
    WidgetsBinding.instance.addPostFrameCallback((_) { if (mounted) _warmBng(hosts); });

    return ListView.builder(
      padding: const EdgeInsets.fromLTRB(0, 6, 0, 40),
      itemCount: names.length,
      itemBuilder: (_, i) {
        final dev    = names[i];
        final dHosts = byDevice[dev]!;
        final probs  = dHosts.fold<int>(0, (s, h) =>
            s + (_probByHost[(h['hostid'] ?? '').toString()] ?? 0));
        return _ListTileCard(
          icon: Icons.router, color: gc, title: dev,
          subtitle: '${dHosts.length} host${dHosts.length == 1 ? '' : 's'}',
          alertCount: probs > 0 ? probs : null,
          onTap: () => setState(() { _expandedBngDevice = dev; _expandedBngGroup = null; _expandedBngTagGroup = null; }),
        );
      },
    );
  }

  // BNG Level 2: group category tiles
  Widget _buildBngGroupTiles(String device, List<dynamic> deviceHosts, Color gc) {
    final counts    = <_BngGroup, int>{};
    final tagCounts = <String, int>{};
    bool anyLoaded  = false;
    bool anyLoading = false;

    for (final h in deviceHosts) {
      final hid  = (h['hostid'] ?? '').toString();
      final meta = _bngMeta[hid];
      if (meta == null || !meta.loaded) { anyLoading = true; continue; }
      anyLoaded = true;
      if (meta.tagGroup != null && meta.tagGroup!.isNotEmpty) {
        tagCounts[meta.tagGroup!] = (tagCounts[meta.tagGroup!] ?? 0) + 1;
        continue;
      }
      if (meta.groups.isNotEmpty) {
        for (final g in meta.groups) counts[g] = (counts[g] ?? 0) + 1;
      } else {
        tagCounts['Unclassified'] = (tagCounts['Unclassified'] ?? 0) + 1;
      }
    }

    // Ordered: System Health, SAP, Port Details
    final orderedGroups = [_BngGroup.systemHealth, _BngGroup.sapInterfaces, _BngGroup.portDetails]
        .where((g) => (counts[g] ?? 0) > 0).toList();
    final orderedTags = tagCounts.keys.toList()..sort();

    return ListView(
      padding: const EdgeInsets.fromLTRB(0, 6, 0, 40),
      children: [
        // Back row
        _buildBackRow(device, Icons.router, gc,
          () => setState(() { _expandedBngDevice = null; _expandedBngGroup = null; _expandedBngTagGroup = null; })),
        const SizedBox(height: 12),

        // Loading indicator
        if (anyLoading && !anyLoaded)
          Padding(
            padding: const EdgeInsets.only(bottom: 12),
            child: Row(children: [
              SizedBox(width: 14, height: 14, child: CircularProgressIndicator(strokeWidth: 1.5, color: gc)),
              const SizedBox(width: 8),
              Text('Detecting discovery rules…', style: TextStyle(fontSize: 11, color: gc)),
            ]),
          )
        else if (anyLoading)
          Padding(
            padding: const EdgeInsets.only(bottom: 6),
            child: Text('Detecting more hosts…',
              style: TextStyle(fontSize: 10, color: ZbxT.textSec(context)))),

    if (orderedGroups.isEmpty && orderedTags.isEmpty && !anyLoading)
      Padding(padding: const EdgeInsets.only(top: 20),
        child: Center(child: Text('No discovery data found',
            style: TextStyle(color: ZbxT.textSec(context)))))
        else
          // 2-column grid (discovery groups + hostgroup tags)
          ...() {
            final tiles = <Widget>[];
            for (final g in orderedGroups) {
              tiles.add(_BngGroupTile(
                group: g, hostCount: counts[g] ?? 0,
                onTap: () => setState(() {
                  _expandedBngGroup = g; _expandedBngTagGroup = null;
                  _expandedHostId = null; _expandedHostName = null;
                }),
              ));
            }
            for (final tag in orderedTags) {
              tiles.add(_BngTagTile(
                label: tag,
                hostCount: tagCounts[tag] ?? 0,
                color: gc,
                onTap: () => setState(() {
                  _expandedBngTagGroup = tag; _expandedBngGroup = null;
                  _expandedHostId = null; _expandedHostName = null;
                }),
              ));
            }

            final rows = <Widget>[];
            for (var i = 0; i < tiles.length; i += 2) {
              final t1 = tiles[i];
              final t2 = i + 1 < tiles.length ? tiles[i + 1] : null;
              rows.add(Padding(
                padding: const EdgeInsets.only(bottom: 2),
                child: Row(children: [
                  Expanded(child: t1),
                  const SizedBox(width: 2),
                  if (t2 != null)
                    Expanded(child: t2)
                  else
                    const Expanded(child: SizedBox()),
                ]),
              ));
            }
            return rows;
          }(),

        const SizedBox(height: 8),
        Text('${deviceHosts.length} total host${deviceHosts.length == 1 ? '' : 's'} in $device',
          style: TextStyle(fontSize: 10, color: ZbxT.textSec(context))),
      ],
    );
  }

  // BNG Level 3: hosts in selected category
  Widget _buildBngCatHostList(List<dynamic> hosts, _BngGroup group) {
    return ListView(
      padding: const EdgeInsets.fromLTRB(0, 6, 0, 40),
      children: [
        _buildBackRow(group.label, group.icon, group.color,
          () => setState(() => _expandedBngGroup = null)),
        const SizedBox(height: 10),
        if (hosts.isEmpty)
          Padding(padding: const EdgeInsets.only(top: 20),
            child: Center(child: Text('No hosts in this category',
                style: TextStyle(color: ZbxT.textSec(context)))))
        else
          ...hosts.map((h) => _buildHostTile(h, group.color)),
      ],
    );
  }

  Widget _buildBngSapItems(List<dynamic> deviceHosts, Color gc) {
    final sapHosts = deviceHosts.where((h) {
      final hid = (h['hostid'] ?? '').toString();
      final meta = _bngMeta[hid];
      if (meta == null || !meta.loaded) return false;
      if (meta.tagGroup != null && meta.tagGroup!.isNotEmpty) return false;
      return meta.groups.contains(_BngGroup.sapInterfaces);
    }).toList();

    WidgetsBinding.instance.addPostFrameCallback((_) {
      for (final h in sapHosts) {
        final hid = (h['hostid'] ?? '').toString();
        if (hid.isNotEmpty) _unawaited(_prefetchHostItems(hid));
      }
    });

    String? _sapIdFromKey(String key) {
      final l = key.indexOf('[');
      if (l < 0) return null;
      final r = key.indexOf(']', l + 1);
      if (r <= l + 1) return null;
      final v = key.substring(l + 1, r).trim();
      return v.isEmpty ? null : v;
    }

    final sapSections = <Widget>[];
    for (final h in sapHosts) {
      final hid   = (h['hostid'] ?? '').toString();
      final name  = (h['name'] ?? h['host'] ?? '').toString();
      final ip    = extractIp(h);
      final items = _itemsForBngGroup(hid, _BngGroup.sapInterfaces);
      final loading = _loadingItems[hid] == true && items.isEmpty;

      final map = <String, List<dynamic>>{};
      if (!loading) {
        for (final item in items) {
          final key = (item['key_'] ?? item['key'] ?? '').toString();
          final base = _baseKey(key);
          if (base != 'sap.if.rx_bytes' && base != 'sap.if.tx_bytes') continue;
          final sapId = _sapIdFromKey(key);
          if (sapId == null) continue;
          map.putIfAbsent(sapId, () => []).add(item);
        }
      }
      final sapIds = map.keys.toList()..sort();
      if (!loading && sapIds.isEmpty) continue;

      sapSections.addAll([
        // Metro solid section banner for this host
        Container(
          margin: const EdgeInsets.only(top: 2, bottom: 2),
          color: gc,
          padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 9),
          child: Row(children: [
            const Icon(Icons.dns_outlined, size: 14, color: Colors.white),
            const SizedBox(width: 8),
            Expanded(child: Text(name, style: const TextStyle(fontSize: 12,
                fontWeight: FontWeight.w700, color: Colors.white))),
            Text(ip, style: TextStyle(fontSize: 9,
                color: Colors.white.withValues(alpha: 0.8), fontFamily: 'monospace')),
          ]),
        ),
        if (loading)
          Padding(
            padding: const EdgeInsets.only(bottom: 8),
            child: Row(children: [
              SizedBox(width: 12, height: 12, child: CircularProgressIndicator(strokeWidth: 1.5, color: gc)),
              const SizedBox(width: 6),
              Text('Loading items...', style: TextStyle(fontSize: 10, color: gc)),
            ]),
          )
        else ...[
          InterfaceListSection(
            title: 'SAP INTERFACES',
            interfaceNames: sapIds,
            itemsByName: map,
            accentColor: ZbxPalette.txGreen,
            titleColor: ZbxPalette.txGreen,
            icon: Icons.hub_outlined,
            iconSize: 17,
            headerPadding: const EdgeInsets.fromLTRB(14, 4, 14, 4),
            onTap: (ifName, items) => _openIf(
              hid: hid,
              hname: name,
              hip: ip,
              ifName: ifName,
              items: items,
              order: sapIds,
              map: map,
              isSap: true,
            ),
          ),
        ],
        const SizedBox(height: 8),
      ]);
    }

    return ListView(
      padding: const EdgeInsets.fromLTRB(0, 6, 0, 40),
      children: [
        _buildBackRow(_BngGroup.sapInterfaces.label, _BngGroup.sapInterfaces.icon, _BngGroup.sapInterfaces.color,
          () => setState(() => _expandedBngGroup = null)),
        const SizedBox(height: 10),
        if (sapHosts.isEmpty || sapSections.isEmpty)
          Padding(padding: const EdgeInsets.only(top: 20),
            child: Center(child: Text('No SAP items found',
                style: TextStyle(color: ZbxT.textSec(context)))))
        else
          ...sapSections,
      ],
    );
  }

  Widget _buildBngHostItemsDetail(List<dynamic> hosts, _BngGroup group, Color gc) {
    final hid = _expandedHostId ?? '';
    final host = hosts.firstWhere(
      (h) => (h['hostid'] ?? '').toString() == hid,
      orElse: () => null,
    );
    if (host == null) return _buildBngCatHostList(hosts, group);

    _unawaited(_prefetchHostItems(hid));
    final items = _itemsForBngGroup(hid, group);
    final loading = _loadingItems[hid] == true && items.isEmpty;

    if (group != _BngGroup.systemHealth) {
      return ListView(
        padding: const EdgeInsets.fromLTRB(0, 6, 0, 40),
        children: [
          _buildBackRow(group.label, group.icon, group.color,
            () => setState(() => _expandedBngGroup = null)),
          const SizedBox(height: 10),
          _buildHostTile(host, gc),
          const SizedBox(height: 8),
          if (loading)
            Row(children: [
              SizedBox(width: 12, height: 12, child: CircularProgressIndicator(strokeWidth: 1.5, color: gc)),
              const SizedBox(width: 6),
              Text('Loading items...', style: TextStyle(fontSize: 10, color: gc)),
            ])
          else if (items.isEmpty)
            Text('No items for this category', style: TextStyle(fontSize: 10, color: ZbxT.textSec(context)))
          else
            ...items.map((item) {
              final iname = (item['name'] ?? item['key_'] ?? 'Item').toString();
              final val = (item['lastvalue'] ?? '-').toString();
              final units = (item['units'] ?? '').toString();
              final display = units.isNotEmpty ? '$val $units' : val;
              return Padding(
                padding: const EdgeInsets.symmetric(vertical: 3),
                child: Row(
                  children: [
                    Expanded(
                      child: Text(iname, maxLines: 1, overflow: TextOverflow.ellipsis,
                        style: TextStyle(fontSize: 11, color: ZbxT.textPri(context))),
                    ),
                    const SizedBox(width: 8),
                    Text(display, style: TextStyle(fontSize: 11, fontWeight: FontWeight.w700, color: gc)),
                  ],
                ),
              );
            }).toList(),
        ],
      );
    }

    final meta = _bngMeta[hid];
    final ruleByKeyBase = meta?.ruleByKeyBase ?? const <String, String>{};
    final sections = <String, List<dynamic>>{};
    const sysRules = {
      'BNG Chassis Component Discovery',
      'BNG CPU Process Discovery',
      'BNG Health Discovery',
      'BNG Subscriber Management',
      'BNG Memory Pool Discovery',
    };
    const cpuMem = {
      'BNG CPU Process Discovery',
      'BNG Memory Pool Discovery',
    };
    for (final item in items) {
      final key = (item['key_'] ?? item['key'] ?? '').toString();
      final base = _baseKey(key);
      final ruleName = ruleByKeyBase[base] ?? '';
      if (!sysRules.contains(ruleName)) continue;
      final label = cpuMem.contains(ruleName) ? 'CPU & Memory' : ruleName;
      sections.putIfAbsent(label, () => []).add(item);
    }
    final sectionNames = sections.keys
        .where((s) => s != 'CPU & Memory' && s != 'BNG Subscriber Management')
        .toList();

    String _displayVal(dynamic item) {
      final val = (item['lastvalue'] ?? '-').toString();
      final units = (item['units'] ?? '').toString();
      return units.isNotEmpty ? '$val $units' : val;
    }

    String _fmtBytes(num v) {
      const units = ['B', 'KB', 'MB', 'GB', 'TB'];
      var d = v.toDouble();
      var i = 0;
      while (d >= 1024 && i < units.length - 1) {
        d /= 1024;
        i++;
      }
      final fixed = d >= 100 ? 0 : d >= 10 ? 1 : 2;
      return '${d.toStringAsFixed(fixed)} ${units[i]}';
    }

    String _bytesDisplay(dynamic item) {
      final raw = (item['lastvalue'] ?? '').toString().replaceAll(',', '').trim();
      final n = double.tryParse(raw);
      if (n == null) return _displayVal(item);
      return _fmtBytes(n);
    }

    String _secondArg(String key) {
      final l = key.indexOf('[');
      if (l < 0) return '';
      final r = key.indexOf(']', l + 1);
      if (r <= l + 1) return '';
      final inside = key.substring(l + 1, r);
      final parts = inside.split(',');
      if (parts.length >= 2) return parts[1].trim();
      return parts[0].trim();
    }

    Widget _cpuMemTable(List<dynamic> itemsIn) {
      final rows = <String, Map<String, String>>{};
      for (final item in itemsIn) {
        final key = (item['key_'] ?? item['key'] ?? '').toString();
        final base = _baseKey(key);
        final row = _secondArg(key);
        if (row.isEmpty) continue;
        rows.putIfAbsent(row, () => <String, String>{});
        if (base == 'bng.cpu.proc') {
          rows[row]!['cpu'] = _displayVal(item);
        } else if (base == 'bng.cpu.proc_capacity') {
          rows[row]!['cap'] = _displayVal(item);
        } else if (base == 'bng.mem.pool.in_use') {
          rows[row]!['mem'] = _bytesDisplay(item);
        }
      }
      final keys = rows.keys.toList()..sort();
      if (keys.isEmpty) {
        return Text('No CPU/Memory items', style: TextStyle(fontSize: 10, color: ZbxT.textSec(context)));
      }

      return Container(
        padding: const EdgeInsets.all(8),
        color: ZbxT.card(context),
        child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
          Row(children: [
            Expanded(
              flex: 3,
              child: Text('Process', style: TextStyle(fontSize: 10, fontWeight: FontWeight.w700, color: gc))),
            Expanded(
              flex: 2,
              child: Text('CPU Utilization', style: TextStyle(fontSize: 10, fontWeight: FontWeight.w700, color: gc))),
            Expanded(
              flex: 2,
              child: Text('Capacity Utilization', style: TextStyle(fontSize: 10, fontWeight: FontWeight.w700, color: gc))),
            Expanded(
              flex: 2,
              child: Text('Memory In-Use', style: TextStyle(fontSize: 10, fontWeight: FontWeight.w700, color: gc))),
          ]),
          const SizedBox(height: 6),
          ...keys.map((k) {
            final row = rows[k]!;
            return Padding(
              padding: const EdgeInsets.symmetric(vertical: 3),
              child: Row(children: [
                Expanded(
                  flex: 3,
                  child: Text(k, maxLines: 1, overflow: TextOverflow.ellipsis,
                    style: TextStyle(fontSize: 10, color: ZbxT.textPri(context)))),
                Expanded(
                  flex: 2,
                  child: Text(row['cpu'] ?? '–',
                    style: TextStyle(fontSize: 10, fontWeight: FontWeight.w700, color: gc))),
                Expanded(
                  flex: 2,
                  child: Text(row['cap'] ?? '–',
                    style: TextStyle(fontSize: 10, fontWeight: FontWeight.w700, color: gc))),
                Expanded(
                  flex: 2,
                  child: Text(row['mem'] ?? '–',
                    style: TextStyle(fontSize: 10, fontWeight: FontWeight.w700, color: gc))),
              ]),
            );
          }),
        ]),
      );
    }

    String _fmtSubKey(String raw) => raw.replaceAll('_', ' ').toUpperCase();

    Widget _twoColGrid(List<Widget> cards) {
      return LayoutBuilder(builder: (context, constraints) {
        final gap = 2.0;
        final w = (constraints.maxWidth - gap) / 2;
        return Wrap(
          spacing: gap,
          runSpacing: gap,
          children: cards.map((c) => SizedBox(width: w, child: c)).toList(),
        );
      });
    }

    Widget _subscriberTable(List<dynamic> itemsIn) {
      final current = <String, String>{};
      final peak = <String, String>{};
      final rows = <String, Map<String, String>>{};
      for (final item in itemsIn) {
        final key = (item['key_'] ?? item['key'] ?? '').toString();
        final base = _baseKey(key);
        if (base != 'bng.sub.current' && base != 'bng.sub.peak') continue;
        final rowRaw = _secondArg(key);
        if (rowRaw.isEmpty) continue;
        rows.putIfAbsent(rowRaw, () => <String, String>{});
        if (base == 'bng.sub.current') {
          final row = _fmtSubKey(rowRaw);
          if (row.isNotEmpty) current[row] = _displayVal(item);
          rows[rowRaw]!['current'] = _displayVal(item);
        } else if (base == 'bng.sub.peak') {
          final row = _fmtSubKey(rowRaw);
          if (row.isNotEmpty) peak[row] = _displayVal(item);
          rows[rowRaw]!['peak'] = _displayVal(item);
        }
      }
      final keys = rows.keys.toList()..sort();
      final setupKey = 'PFCP SESSIONS IN SETUP';
      final totalKey = 'TOTAL PFCP SESSIONS PPP';
      final setupVal = current[setupKey] ?? peak[setupKey] ?? '–';
      final totalVal = current[totalKey] ?? peak[totalKey] ?? '–';

      Widget _metricCard(String label, String value, String desc) {
        // Metro solid-color metric tile
        return Container(
          padding: const EdgeInsets.all(12),
          color: gc,
          child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
            Text(label, style: TextStyle(fontSize: 9,
                color: Colors.white.withValues(alpha: 0.8), letterSpacing: 0.4)),
            const SizedBox(height: 6),
            Text(value, style: const TextStyle(fontSize: 22,
                fontWeight: FontWeight.w800, color: Colors.white, height: 1.0)),
            const SizedBox(height: 4),
            Text(desc, style: TextStyle(fontSize: 9,
                color: Colors.white.withValues(alpha: 0.7))),
          ]),
        );
      }

      if (keys.isEmpty) {
        return Text('No Subscriber items', style: TextStyle(fontSize: 10, color: ZbxT.textSec(context)));
      }
      return Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          _twoColGrid([
            _metricCard('PFCP SESSIONS IN SETUP', setupVal, 'Indicating connecting subscribers'),
            _metricCard('TOTAL PFCP SESSIONS PPP', totalVal, 'Indicating connected subscribers'),
          ]),
          const SizedBox(height: 8),
          Container(
            padding: const EdgeInsets.all(8),
            color: ZbxT.card(context),
            child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
              Row(children: [
                Expanded(
                  flex: 3,
                  child: Text('Name', style: TextStyle(fontSize: 10, fontWeight: FontWeight.w700, color: gc))),
                Expanded(
                  flex: 2,
                  child: Text('Current', style: TextStyle(fontSize: 10, fontWeight: FontWeight.w700, color: gc))),
                Expanded(
                  flex: 2,
                  child: Text('Peak', style: TextStyle(fontSize: 10, fontWeight: FontWeight.w700, color: gc))),
              ]),
              const SizedBox(height: 6),
              ...keys.map((k) {
                final row = rows[k]!;
                return Padding(
                  padding: const EdgeInsets.symmetric(vertical: 3),
                  child: Row(children: [
                    Expanded(
                      flex: 3,
                      child: Text(_fmtSubKey(k), maxLines: 1, overflow: TextOverflow.ellipsis,
                        style: TextStyle(fontSize: 10, color: ZbxT.textPri(context)))),
                    Expanded(
                      flex: 2,
                      child: Text(row['current'] ?? '–',
                        style: TextStyle(fontSize: 10, fontWeight: FontWeight.w700, color: gc))),
                    Expanded(
                      flex: 2,
                      child: Text(row['peak'] ?? '–',
                        style: TextStyle(fontSize: 10, fontWeight: FontWeight.w700, color: gc))),
                  ]),
                );
              }),
            ]),
          ),
        ],
      );
    }

    String _sectionKey(String hid, String section) => 'bng:$hid:$section';

    Widget _collapseSection({
      required String hid,
      required String title,
      required Widget child,
      Widget? headerChild,
    }) {
      final key = _sectionKey(hid, title);
      final expanded = _sectionExpanded[key] == true;
      return Container(
        margin: const EdgeInsets.only(bottom: 4),
        color: ZbxT.card(context),
        child: Column(children: [
          InkWell(
            onTap: () => setState(() => _sectionExpanded[key] = !expanded),
            child: Container(
              padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 11),
              decoration: BoxDecoration(
                // Metro: thick top border = section separator
                border: Border(top: BorderSide(color: gc, width: 3))),
              child: Row(children: [
                Expanded(
                  child: headerChild ??
                      Text(title, style: TextStyle(fontSize: 12, fontWeight: FontWeight.w800,
                          color: ZbxT.textPri(context), letterSpacing: 0.2)),
                ),
                Container(
                  padding: const EdgeInsets.all(2),
                  color: gc,
                  child: Icon(expanded ? Icons.remove : Icons.add,
                      size: 14, color: Colors.white)),
              ]),
            ),
          ),
          if (expanded)
            Padding(
              padding: const EdgeInsets.fromLTRB(10, 0, 10, 10),
              child: child,
            ),
        ]),
      );
    }

    int _sortToken(String s) => int.tryParse(s) ?? 999999;

    Color _gaugeColor(double v) {
      if (v >= 90) return ZbxPalette.downRed;
      if (v >= 70) return const Color(0xFFF39C12);
      if (v >= 50) return const Color(0xFFF1C40F);
      return const Color(0xFF2ECC71);
    }

    Widget _fanGauge(double v, String valueLabel, {required double size}) {
      final pct = v.clamp(0, 100).toDouble();
      final color = _gaugeColor(pct);
      final fraction = pct / 100.0;
      return SizedBox(
        width: size,
        height: size,
        child: CustomPaint(
          painter: _ArcGaugePainter(
            fraction: fraction,
            trackColor: ZbxT.rim(context),
            fillColor: color,
          ),
          child: Center(
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                Text(valueLabel,
                  style: TextStyle(fontSize: 16, fontWeight: FontWeight.w800, color: color)),
                Text('${pct.toStringAsFixed(0)}%',
                  style: TextStyle(fontSize: 10, fontWeight: FontWeight.w700, color: color)),
              ],
            ),
          ),
        ),
      );
    }

    Widget _fanCard(String fan, dynamic speedItem, dynamic stateItem) {
      final speedRaw    = (speedItem?['lastvalue'] ?? '').toString().replaceAll(',', '').trim();
      final speedVal    = double.tryParse(speedRaw) ?? 0.0;
      final speedUnits  = (speedItem?['units'] ?? '').toString();
      final speedDisplay = speedUnits.isNotEmpty
          ? '${speedVal.toStringAsFixed(0)} $speedUnits'
          : speedVal.toStringAsFixed(0);
      final stateRaw = (stateItem?['lastvalue'] ?? '').toString().trim();
      final online   = stateRaw == '1';
      // Metro fan card: flat, no rounding, bold label
      return LayoutBuilder(builder: (context, constraints) {
        final size = (constraints.maxWidth * 0.5).clamp(48.0, 76.0);
        return Container(
          padding: const EdgeInsets.all(10),
          color: ZbxT.card(context),
          child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
            Text('FAN $fan', style: TextStyle(fontSize: 10, fontWeight: FontWeight.w800,
                color: gc, letterSpacing: 0.6)),
            const SizedBox(height: 8),
            Center(child: _fanGauge(speedVal, speedDisplay, size: size)),
            const SizedBox(height: 8),
            // Metro status badge — no rounding
            Container(
              width: double.infinity,
              padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 4),
              color: online ? const Color(0xFF008A00) : ZbxPalette.downRed,
              child: Text(online ? 'ONLINE' : 'OFFLINE',
                textAlign: TextAlign.center,
                style: const TextStyle(fontSize: 9, fontWeight: FontWeight.w800,
                    color: Colors.white, letterSpacing: 0.6))),
          ]),
        );
      });
    }

    Widget _psuValueCard(String label, String value) {
      // Metro flat PSU tile — solid dark bg, colored value
      return Container(
        padding: const EdgeInsets.all(10),
        color: ZbxT.card(context),
        child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
          Text(label, style: TextStyle(fontSize: 10, fontWeight: FontWeight.w700,
              color: gc, letterSpacing: 0.4)),
          const Spacer(),
          Text(value, style: TextStyle(fontSize: 20, fontWeight: FontWeight.w800, color: gc)),
        ]),
      );
    }

    Widget _chassisCards(List<dynamic> itemsIn) {
      final fanSpeed = <String, dynamic>{};
      final fanState = <String, dynamic>{};
      final psuV1 = <String, dynamic>{};
      final psuV2 = <String, dynamic>{};

      for (final item in itemsIn) {
        final key = (item['key_'] ?? item['key'] ?? '').toString();
        final base = _baseKey(key);
        final id = _secondArg(key);
        if (id.isEmpty) continue;
        if (base == 'bng.chassis.fan_speed') {
          fanSpeed[id] = item;
        } else if (base == 'bng.chassis.fan_state') {
          fanState[id] = item;
        } else if (base == 'bng.chassis.psu_v1') {
          psuV1[id] = item;
        } else if (base == 'bng.chassis.psu_v2') {
          psuV2[id] = item;
        }
      }

      final fanCards = <Widget>[];
      final fanKeys = {...fanSpeed.keys, ...fanState.keys}.toList()
        ..sort((a, b) => _sortToken(a).compareTo(_sortToken(b)));
      for (final k in fanKeys) {
        fanCards.add(_fanCard(k, fanSpeed[k], fanState[k]));
      }
      if (fanCards.isEmpty) {
        return Text('No Chassis items', style: TextStyle(fontSize: 10, color: ZbxT.textSec(context)));
      }
      return Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          if (fanCards.isNotEmpty)
            Row(
              children: [
                for (var i = 0; i < fanCards.length; i++) ...[
                  Expanded(child: fanCards[i]),
                  if (i < fanCards.length - 1) const SizedBox(width: 6),
                ],
              ],
            ),
        ],
      );
    }

    double? _valNum(dynamic item) {
      final raw = (item?['lastvalue'] ?? '').toString().replaceAll(',', '').trim();
      return double.tryParse(raw);
    }

    Widget _memoryBar({
      required double? total,
      required double? inUse,
      required double? available,
      required double? utilPct,
    }) {
      if (total == null || total <= 0) {
        return Padding(
          padding: const EdgeInsets.all(12),
          child: Text('No Memory data',
            style: TextStyle(fontSize: 10, color: ZbxT.textSec(context))));
      }
      // total = allocated pool; available = free portion; in_use = used portion
      // Bar spans full width = total. in_use draws from left (blue).
      // available draws from right-of-inuse (green).
      final inUseVal  = (inUse ?? 0).clamp(0, total).toDouble();
      final availVal  = (available ?? 0).clamp(0, total - inUseVal).toDouble();
      final inUseFrac  = (inUseVal / total).clamp(0.0, 1.0);
      final availFrac  = (availVal / total).clamp(0.0, 1.0);
      final utilLabel  = utilPct != null ? '${utilPct.toStringAsFixed(1)}%' : '-';
      final utilColor  = (utilPct ?? 0) >= 90 ? ZbxPalette.downRed
          : (utilPct ?? 0) >= 70 ? const Color(0xFFF39C12)
          : const Color(0xFF2ECC71);

      fmtB(double v) {
        if (v >= 1 << 30) return '${(v / (1 << 30)).toStringAsFixed(1)} GB';
        if (v >= 1 << 20) return '${(v / (1 << 20)).toStringAsFixed(0)} MB';
        if (v >= 1 << 10) return '${(v / (1 << 10)).toStringAsFixed(0)} KB';
        return '${v.toStringAsFixed(0)} B';
      }

      return Container(
        margin: const EdgeInsets.only(bottom: 2),
        color: ZbxT.card(context),
        padding: const EdgeInsets.all(12),
        child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
          // Header row
          Row(children: [
            Text('MEMORY', style: TextStyle(fontSize: 10, fontWeight: FontWeight.w800,
                color: gc, letterSpacing: 0.6)),
            const Spacer(),
            Container(
              padding: const EdgeInsets.symmetric(horizontal: 7, vertical: 3),
              color: utilColor,
              child: Text('UTIL $utilLabel', style: const TextStyle(fontSize: 9,
                  fontWeight: FontWeight.w800, color: Colors.white, letterSpacing: 0.5))),
          ]),
          const SizedBox(height: 10),
          // Metro stacked bar — flat, full width, taller for visibility
          LayoutBuilder(builder: (context, constraints) {
            final w = constraints.maxWidth;
            return Stack(children: [
              // Background (unallocated/waste)
              Container(height: 16, color: ZbxT.rim(context)),
              // Total allocated — light blue
              Container(height: 16, width: w, color: const Color(0xFFB3D9FF)),
              // In-use — full blue (from left)
              Container(height: 16, width: w * inUseFrac, color: ZbxPalette.rxBlue),
              // Available — green (right portion of total)
              if (availFrac > 0)
                Positioned(left: w * inUseFrac,
                  child: Container(height: 16, width: w * availFrac,
                    color: const Color(0xFF26C67C))),
            ]);
          }),
          const SizedBox(height: 8),
          // Legend
          Row(children: [
            Container(width: 10, height: 10, color: ZbxPalette.rxBlue),
            const SizedBox(width: 5),
            Text('In Use  ${fmtB(inUseVal)}',
              style: TextStyle(fontSize: 9, color: ZbxT.textSec(context))),
            const SizedBox(width: 12),
            Container(width: 10, height: 10, color: const Color(0xFF26C67C)),
            const SizedBox(width: 5),
            Text('Available  ${fmtB(availVal)}',
              style: TextStyle(fontSize: 9, color: ZbxT.textSec(context))),
            const SizedBox(width: 12),
            Container(width: 10, height: 10, color: const Color(0xFFB3D9FF)),
            const SizedBox(width: 5),
            Text('Total  ${fmtB(total)}',
              style: TextStyle(fontSize: 9, color: ZbxT.textSec(context))),
          ]),
        ]),
      );
    }

    Widget _utilBar(double fraction, Color color) {
      final f = fraction.clamp(0, 1).toDouble();
      return LayoutBuilder(builder: (context, constraints) {
        final w = constraints.maxWidth;
        return Stack(children: [
          Container(height: 6, color: ZbxT.rim(context)),
          Container(height: 6, width: w * f, color: color),
        ]);
      });
    }

    Widget _cpuCard({double? usage, double? busiest, double? idle}) {
      final u      = (usage?.clamp(0, 100) ?? 0.0).toDouble();
      final b      = (busiest?.clamp(0, 100) ?? 0.0).toDouble();
      final uColor = _gaugeColor(u);
      final bColor = const Color(0xFFFFAB40);
      // Metro CPU card — flat, no rounding
      return Container(
        padding: const EdgeInsets.all(12),
        color: ZbxT.card(context),
        child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
          Text('CPU', style: TextStyle(fontSize: 10, fontWeight: FontWeight.w800,
              color: gc, letterSpacing: 0.6)),
          const SizedBox(height: 10),
          // Usage row
          Row(children: [
            Text('USAGE', style: TextStyle(fontSize: 9, color: ZbxT.textSec(context),
                letterSpacing: 0.5)),
            const Spacer(),
            Text('${u.toStringAsFixed(0)}%', style: TextStyle(fontSize: 11,
                fontWeight: FontWeight.w800, color: uColor)),
          ]),
          const SizedBox(height: 4),
          _utilBar(u / 100.0, uColor),
          const SizedBox(height: 10),
          // Busiest row
          Row(children: [
            Text('BUSIEST CORE', style: TextStyle(fontSize: 9, color: ZbxT.textSec(context),
                letterSpacing: 0.5)),
            const Spacer(),
            Text('${b.toStringAsFixed(0)}%', style: TextStyle(fontSize: 11,
                fontWeight: FontWeight.w800, color: bColor)),
          ]),
          const SizedBox(height: 4),
          _utilBar(b / 100.0, bColor),
          if (idle != null) ...[
            const SizedBox(height: 8),
            Text('IDLE: ${idle.toStringAsFixed(1)}%',
              style: TextStyle(fontSize: 9, color: ZbxT.textSec(context), letterSpacing: 0.4)),
          ],
        ]),
      );
    }

    Widget _tempCard({double? temp, bool? overTemp}) {
      final t     = (temp?.clamp(0, 100) ?? 0.0).toDouble();
      final color = _gaugeColor(t);
      final alert = overTemp == true;
      // Metro temp card — flat, no rounding, vertical bar thermometer
      return Container(
        padding: const EdgeInsets.all(10),
        color: ZbxT.card(context),
        child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
          Row(children: [
            Text('TEMP', style: TextStyle(fontSize: 10, fontWeight: FontWeight.w800,
                color: gc, letterSpacing: 0.6)),
            const Spacer(),
            Container(
              padding: const EdgeInsets.symmetric(horizontal: 5, vertical: 2),
              color: alert ? ZbxPalette.downRed : const Color(0xFF008A00),
              child: Text(alert ? 'ALERT' : 'OK',
                style: const TextStyle(fontSize: 8, fontWeight: FontWeight.w800,
                    color: Colors.white, letterSpacing: 0.5))),
          ]),
          const SizedBox(height: 10),
          Row(crossAxisAlignment: CrossAxisAlignment.end, children: [
            // Vertical bar — Metro style (flat)
            Container(
              width: 12, height: 64,
              color: ZbxT.rim(context),
              child: Align(
                alignment: Alignment.bottomCenter,
                child: Container(height: 64 * (t / 100.0).clamp(0, 1), color: color),
              ),
            ),
            const SizedBox(width: 10),
            Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
              Text('${t.toStringAsFixed(1)}',
                style: TextStyle(fontSize: 20, fontWeight: FontWeight.w800, color: color, height: 1)),
              Text('°C', style: TextStyle(fontSize: 11, color: color.withValues(alpha: 0.8))),
            ]),
          ]),
        ]),
      );
    }

    Widget _healthCards(List<dynamic> itemsIn) {
      dynamic memInUse;
      dynamic memTotal;
      dynamic memAvail;
      dynamic memUtil;
      dynamic cpuUsage;
      dynamic cpuBusiest;
      dynamic cpuIdle;
      dynamic temp;
      dynamic overTemp;

      for (final item in itemsIn) {
        final key = (item['key_'] ?? item['key'] ?? '').toString();
        final base = _baseKey(key);
        if (base == 'bng.mem.in_use') memInUse = item;
        if (base == 'bng.mem.total') memTotal = item;
        if (base == 'bng.mem.available') memAvail = item;
        if (base == 'bng.mem.total_utilization') memUtil = item;
        if (base == 'bng.cpu.usage') cpuUsage = item;
        if (base == 'bng.cpu.busiest_core') cpuBusiest = item;
        if (base == 'bng.cpu.idle') cpuIdle = item;
        if (base == 'bng.chassis.ccm_temp') temp = item;
        if (base == 'bng.chassis.over_temp') overTemp = item;
      }

      // PSU values from full host items (not in health discovery)
      final psuV1 = <String, dynamic>{};
      final psuV2 = <String, dynamic>{};
      final allItems = _itemsForHost[hid] ?? const <dynamic>[];
      for (final item in allItems) {
        final key = (item['key_'] ?? item['key'] ?? '').toString();
        final base = _baseKey(key);
        final id = _secondArg(key);
        if (id.isEmpty) continue;
        if (base == 'bng.chassis.psu_v1') psuV1[id] = item;
        if (base == 'bng.chassis.psu_v2') psuV2[id] = item;
      }
      final psuIds = {...psuV1.keys, ...psuV2.keys}.toList()
        ..sort((a, b) => _sortToken(a).compareTo(_sortToken(b)));
      final psuId = psuIds.isNotEmpty ? psuIds.first : null;
      final psuV1Item = psuId != null ? psuV1[psuId] : null;
      final psuV2Item = psuId != null ? psuV2[psuId] : null;

      final memBar = _memoryBar(
        total: _valNum(memTotal),
        inUse: _valNum(memInUse),
        available: _valNum(memAvail),
        utilPct: _valNum(memUtil),
      );

      return Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
        memBar,
        const SizedBox(height: 8),
        _cpuCard(
          usage: _valNum(cpuUsage),
          busiest: _valNum(cpuBusiest),
          idle: _valNum(cpuIdle),
        ),
        const SizedBox(height: 8),
        LayoutBuilder(builder: (context, constraints) {
          final gap = 8.0;
          final w = (constraints.maxWidth - gap * 2) / 3;
          const h = 120.0;
          return Row(children: [
            SizedBox(width: w, height: h, child: _tempCard(
              temp: _valNum(temp),
              overTemp: (_valNum(overTemp) ?? 0) >= 1,
            )),
            SizedBox(width: gap),
            SizedBox(width: w, height: h, child: _psuValueCard(
              psuId != null ? 'PSU $psuId V1' : 'PSU V1',
              psuV1Item == null ? '–' : _displayVal(psuV1Item))),
            SizedBox(width: gap),
            SizedBox(width: w, height: h, child: _psuValueCard(
              psuId != null ? 'PSU $psuId V2' : 'PSU V2',
              psuV2Item == null ? '–' : _displayVal(psuV2Item))),
          ]);
        }),
      ]);
    }

    return ListView(
      padding: const EdgeInsets.fromLTRB(0, 6, 0, 40),
      children: [
        _buildBackRow('${group.label} / ${(host['name'] ?? host['host'] ?? '').toString()}',
          group.icon, group.color, () => setState(() => _expandedBngGroup = null)),
        const SizedBox(height: 8),
        if (loading)
          Row(children: [
            SizedBox(width: 12, height: 12, child: CircularProgressIndicator(strokeWidth: 1.5, color: gc)),
            const SizedBox(width: 6),
            Text('Loading items...', style: TextStyle(fontSize: 10, color: gc)),
          ])
        else if (sectionNames.isEmpty)
          Text('No System Health items', style: TextStyle(fontSize: 10, color: ZbxT.textSec(context)))
        else
          ...sectionNames.expand((section) {
            final itemsIn = sections[section] ?? const <dynamic>[];
            if (section == 'BNG Chassis Component Discovery') {
              return [
                const SizedBox(height: 6),
                _chassisCards(itemsIn),
              ];
            }
            if (section == 'BNG Health Discovery') {
              return [
                const SizedBox(height: 6),
                _healthCards(itemsIn),
              ];
            }
            final rows = itemsIn.map((item) {
              final iname = (item['name'] ?? item['key_'] ?? 'Item').toString();
              final display = _displayVal(item);
              return Padding(
                padding: const EdgeInsets.symmetric(vertical: 3),
                child: Row(
                  children: [
                    Expanded(
                      child: Text(iname, maxLines: 1, overflow: TextOverflow.ellipsis,
                        style: TextStyle(fontSize: 11, color: ZbxT.textPri(context))),
                    ),
                    const SizedBox(width: 8),
                    Text(display, style: TextStyle(fontSize: 11, fontWeight: FontWeight.w700, color: gc)),
                  ],
                ),
              );
            });
            return [
              const SizedBox(height: 6),
              ...rows,
            ];
          }).toList(),
        const SizedBox(height: 6),
        if (sections.containsKey('BNG Subscriber Management'))
          () {
            final itemsIn = sections['BNG Subscriber Management'] ?? const <dynamic>[];
            String _valFor(String key) {
              for (final item in itemsIn) {
                final k = (item['key_'] ?? item['key'] ?? '').toString();
                if (_baseKey(k) != 'bng.sub.current' && _baseKey(k) != 'bng.sub.peak') continue;
                final name = _fmtSubKey(_secondArg(k));
                if (name == key) return _displayVal(item);
              }
              return '–';
            }
            final setupVal = _valFor('PFCP SESSIONS IN SETUP');
            final totalVal = _valFor('TOTAL PFCP SESSIONS PPP');
            final header = Row(children: [
              Expanded(child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
                Text(setupVal, style: TextStyle(fontSize: 18, fontWeight: FontWeight.w800, color: gc)),
                const SizedBox(height: 2),
                Text('Connecting Subscribers',
                  style: TextStyle(fontSize: 9, color: ZbxT.textSec(context))),
              ])),
              Container(
                width: 1,
                height: 36,
                color: ZbxT.textSec(context).withValues(alpha: 0.3)),
              Expanded(child: Column(crossAxisAlignment: CrossAxisAlignment.end, children: [
                Text(totalVal, style: TextStyle(fontSize: 18, fontWeight: FontWeight.w800, color: gc)),
                const SizedBox(height: 2),
                Text('Connected Subscribers',
                  style: TextStyle(fontSize: 9, color: ZbxT.textSec(context))),
              ])),
            ]);
            return _collapseSection(
              hid: hid,
              title: 'Current values of PFCP SESSIONS IN SETUP / TOTAL PFCP SESSIONS PPP',
              headerChild: header,
              child: _subscriberTable(itemsIn),
            );
          }(),
        if (sections.containsKey('CPU & Memory'))
          _collapseSection(
            hid: hid,
            title: 'CPU & Memory',
            child: _cpuMemTable(sections['CPU & Memory'] ?? const <dynamic>[]),
          ),
      ],
    );
  }

  Widget _buildBngPortDetailHostDetail(List<dynamic> hosts, Color gc) {
    final hid = _expandedHostId ?? '';
    final host = hosts.firstWhere(
      (h) => (h['hostid'] ?? '').toString() == hid,
      orElse: () => null,
    );
    if (host == null) return _buildBngCatHostList(hosts, _BngGroup.portDetails);

    _unawaited(_prefetchHostItems(hid));
    final items = _itemsForBngGroup(hid, _BngGroup.portDetails);
    final loading = _loadingItems[hid] == true && items.isEmpty;

    final map = <String, List<dynamic>>{};
    for (final item in items) {
      final entity = entityName(item);
      map.putIfAbsent(entity, () => []).add(item);
    }
    final keys = map.keys.toList()..sort();

    return ListView(
      padding: const EdgeInsets.fromLTRB(0, 6, 0, 40),
      children: [
        _buildBackRow(_BngGroup.portDetails.label, _BngGroup.portDetails.icon, _BngGroup.portDetails.color,
          () => setState(() => _expandedBngGroup = null)),
        const SizedBox(height: 10),
        _buildHostTile(host, gc),
        const SizedBox(height: 8),
        if (loading)
          Row(children: [
            SizedBox(width: 12, height: 12, child: CircularProgressIndicator(strokeWidth: 1.5, color: gc)),
            const SizedBox(width: 6),
            Text('Loading items...', style: TextStyle(fontSize: 10, color: gc)),
          ])
        else if (keys.isEmpty)
          Text('No Port Details items', style: TextStyle(fontSize: 10, color: ZbxT.textSec(context)))
        else ...[
          InterfaceListSection(
            title: 'INTERFACES',
            interfaceNames: keys,
            itemsByName: map,
            accentColor: gc,
            icon: Icons.settings_ethernet,
            iconSize: 17,
            headerPadding: const EdgeInsets.fromLTRB(14, 4, 14, 4),
            onTap: (ifName, items) => _openIf(
              hid: hid,
              hname: (host['name'] ?? host['host'] ?? '').toString(),
              hip: extractIp(host),
              ifName: ifName,
              items: items,
              order: keys,
              map: map,
            ),
          ),
        ],
      ],
    );
  }

  Widget _buildBngTagHostList(List<dynamic> hosts, String tag, Color gc) {
    return ListView(
      padding: const EdgeInsets.fromLTRB(0, 6, 0, 40),
      children: [
        _buildBackRow(tag, Icons.label_outline, gc,
          () => setState(() => _expandedBngTagGroup = null)),
        const SizedBox(height: 10),
        if (hosts.isEmpty)
          Padding(padding: const EdgeInsets.only(top: 20),
            child: Center(child: Text('No hosts in this category',
                style: TextStyle(color: ZbxT.textSec(context)))))
        else
          ...hosts.map((h) => _buildHostTile(h, gc)),
      ],
    );
  }

  Widget _buildBngPingHostList(List<dynamic> hosts, String tag, Color gc) {
    return ListView(
      padding: const EdgeInsets.fromLTRB(0, 6, 0, 40),
      children: [
        _buildBackRow(tag, Icons.label_outline, gc,
          () => setState(() => _expandedBngTagGroup = null)),
        const SizedBox(height: 10),
        if (hosts.isEmpty)
          Padding(padding: const EdgeInsets.only(top: 20),
            child: Center(child: Text('No hosts in this category',
                style: TextStyle(color: ZbxT.textSec(context)))))
        else
          ...hosts.map((h) => _buildPingHostTile(h, gc)),
      ],
    );
  }

  /// Metro ping host row — identical flat Metro style, goes to ping dashboard
  Widget _buildPingHostTile(dynamic host, Color groupColor) {
    final hid   = (host['hostid'] ?? '').toString();
    final hname = (host['name']   ?? host['host'] ?? '').toString();
    final hip   = extractIp(host);
    final probs = _probByHost[hid] ?? 0;
    return GestureDetector(
      onTap: () => _openPingForHost(host, groupColor),
      child: Container(
        margin: const EdgeInsets.only(bottom: 2),
        color: ZbxT.card(context),
        child: IntrinsicHeight(
          child: Row(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
            Container(width: 4, color: groupColor),
            Expanded(
              child: Padding(
                padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 11),
                child: Row(children: [
                  Icon(Icons.dns_outlined, color: groupColor, size: 18),
                  const SizedBox(width: 12),
                  Expanded(
                    child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
                      Text(hname, style: TextStyle(fontWeight: FontWeight.w700,
                          fontSize: 13, color: ZbxT.textPri(context))),
                      const SizedBox(height: 2),
                      Row(mainAxisSize: MainAxisSize.min, children: [
                        Text(hip, style: TextStyle(fontSize: 10,
                            color: ZbxT.textSec(context), fontFamily: 'monospace')),
                        if (probs > 0) ...[
                          const SizedBox(width: 8),
                          Container(
                            padding: const EdgeInsets.symmetric(horizontal: 5, vertical: 1),
                            color: ZbxPalette.downRed,
                            child: Text('$probs alert${probs > 1 ? 's' : ''}',
                              style: const TextStyle(fontSize: 9, color: Colors.white,
                                  fontWeight: FontWeight.w700))),
                        ],
                      ]),
                    ]),
                  ),
                  Icon(Icons.chevron_right,
                      color: ZbxT.textSec(context).withValues(alpha: 0.4), size: 15),
                ]),
              ),
            ),
          ]),
        ),
      ),
    );
  }

  Future<void> _openPingForHost(dynamic host, Color gc) async {
    final hid   = (host['hostid'] ?? '').toString();
    final hname = (host['name'] ?? host['host'] ?? '').toString();
    final hip   = extractIp(host);

    if (!_itemsForHost.containsKey(hid) && _loadingItems[hid] != true) {
      _unawaited(_prefetchHostItems(hid));
    }

    // Use cached items if present, otherwise fetch directly before opening.
    var allItems = _itemsForHost[hid] ?? const <dynamic>[];
    if (allItems.isEmpty) {
      try {
        allItems = await ApiClient.fetchItems(hid);
        if (allItems.isNotEmpty) _processItems(hid, allItems);
      } catch (_) {}
    }

    final items = allItems.where((i) {
      final key = (i['key_'] ?? i['key'] ?? '').toString().toLowerCase();
      return key.startsWith('bng.ping.');
    }).toList();

    if (items.isEmpty) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(SnackBar(
        content: Text('No Ping items found for $hname'),
        duration: const Duration(seconds: 2),
      ));
      return;
    }

    final map = <String, List<dynamic>>{'Ping': items};
    if (!mounted) return;
    _openIf(
      hid: hid,
      hname: hname,
      hip: hip,
      ifName: 'Ping',
      items: items,
      order: const ['Ping'],
      map: map,
    );
  }


  /// Metro back/section header — full-width solid color strip, arrow + title
  Widget _buildBackRow(String title, IconData icon, Color color, VoidCallback onBack) {
    return GestureDetector(
      onTap: onBack,
      child: Container(
        color: color,
        padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 11),
        child: Row(children: [
          const Icon(Icons.arrow_back, color: Colors.white, size: 18),
          const SizedBox(width: 12),
          Icon(icon, size: 15, color: Colors.white.withValues(alpha: 0.9)),
          const SizedBox(width: 10),
          Expanded(child: Text(title,
            maxLines: 1, overflow: TextOverflow.ellipsis,
            style: const TextStyle(fontWeight: FontWeight.w700, color: Colors.white,
                fontSize: 13, letterSpacing: 0.2))),
        ]),
      ),
    );
  }

  /// Metro host row — flat, 4px accent left bar, no rounding/border/shadow
  Widget _buildHostTile(dynamic host, Color groupColor) {
    final hid        = (host['hostid'] ?? '').toString();
    final hname      = (host['name']   ?? host['host'] ?? '').toString();
    final hip        = extractIp(host);
    final isSelected = _expandedHostId == hid;
    final probs      = _probByHost[hid] ?? 0;
    return GestureDetector(
      onTap: () => _toggleHost(host),
      child: Container(
        margin: const EdgeInsets.only(bottom: 2),
        color: isSelected ? groupColor.withValues(alpha: 0.13) : ZbxT.card(context),
        child: IntrinsicHeight(
          child: Row(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
            // Metro left accent — full color when selected, faded when not
            Container(width: 4, color: isSelected ? groupColor : groupColor.withValues(alpha: 0.30)),
            Expanded(
              child: Padding(
                padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 11),
                child: Row(children: [
                  Icon(Icons.dns_outlined, color: groupColor, size: 18),
                  const SizedBox(width: 12),
                  Expanded(
                    child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
                      Text(hname, style: TextStyle(fontWeight: FontWeight.w700,
                          fontSize: 13, color: ZbxT.textPri(context))),
                      const SizedBox(height: 2),
                      Row(mainAxisSize: MainAxisSize.min, children: [
                        Text(hip, style: TextStyle(fontSize: 10,
                            color: ZbxT.textSec(context), fontFamily: 'monospace')),
                        if (probs > 0) ...[
                          const SizedBox(width: 8),
                          Container(
                            padding: const EdgeInsets.symmetric(horizontal: 5, vertical: 1),
                            color: ZbxPalette.downRed,
                            child: Text('$probs alert${probs > 1 ? 's' : ''}',
                              style: const TextStyle(fontSize: 9, color: Colors.white,
                                  fontWeight: FontWeight.w700))),
                        ],
                      ]),
                    ]),
                  ),
                  Icon(Icons.chevron_right,
                      color: isSelected ? groupColor : ZbxT.textSec(context).withValues(alpha: 0.4),
                      size: 15),
                ]),
              ),
            ),
          ]),
        ),
      ),
    );
  }

  // ══════════════════════════════════════════════════════════════════════════
  // NON-BNG HOST LIST & DETAIL
  // ══════════════════════════════════════════════════════════════════════════
  Widget _buildHostList(String gid, String gname, Color gc, {required bool asRail}) {
    final isLoading = _loadingHosts[gid] == true;
    final hosts     = _hostsIn(gid, gname);
    final padding   = asRail ? const EdgeInsets.fromLTRB(0, 4, 0, 8) : const EdgeInsets.fromLTRB(0, 8, 0, 40);

    if (isLoading && hosts.isEmpty) {
      return Center(child: Row(mainAxisSize: MainAxisSize.min, children: [
        SizedBox(width: 14, height: 14, child: CircularProgressIndicator(strokeWidth: 1.8, color: gc)),
        const SizedBox(width: 8),
        Text('Loading hosts…', style: TextStyle(fontSize: 11, color: gc)),
      ]));
    }

    return ListView.builder(
      padding: padding,
      itemCount: hosts.length,
      itemBuilder: (_, i) {
        final h   = hosts[i];
        final hid = (h['hostid'] ?? '').toString();
        if (asRail) {
          final sel = _expandedHostId == hid;
          return GestureDetector(
            onTap: () => _toggleHost(h),
            child: Container(
              margin: const EdgeInsets.only(bottom: 2),
              color: sel ? gc.withValues(alpha: 0.18) : ZbxT.card(context),
              child: IntrinsicHeight(
                child: Row(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
                  Container(width: 3, color: sel ? gc : gc.withValues(alpha: 0.3)),
                  Expanded(
                    child: Padding(
                      padding: const EdgeInsets.symmetric(vertical: 8, horizontal: 8),
                      child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
                        Text((h['name'] ?? h['host'] ?? '').toString(),
                          maxLines: 2, overflow: TextOverflow.ellipsis,
                          style: TextStyle(fontSize: 10, fontWeight: FontWeight.w700,
                              color: ZbxT.textPri(context))),
                        const SizedBox(height: 2),
                        Text(extractIp(h), style: TextStyle(fontSize: 9,
                            color: ZbxT.textSec(context), fontFamily: 'monospace')),
                      ]),
                    ),
                  ),
                ]),
              ),
            ),
          );
        }
        return _buildHostTile(h, gc);
      },
    );
  }

  Widget _buildHostDetail(String gid, String gname, Color gc) {
    final hid  = _expandedHostId ?? '';
    final hosts = _hostsIn(gid, gname);
    final host  = hosts.firstWhere((h) => (h['hostid'] ?? '').toString() == hid, orElse: () => null);
    if (host == null) return _buildHostList(gid, gname, gc, asRail: false);

    return Stack(children: [
      Row(children: [
        AnimatedContainer(
          duration: const Duration(milliseconds: 220), curve: Curves.easeOutCubic,
          width: _showRail ? 220.0 : 0.0,
          child: ClipRect(child: Container(
            color: ZbxT.card(context),
            child: _buildHostList(gid, gname, gc, asRail: true)))),
        Expanded(child: _buildHostDetailBody(host, gc)),
      ]),
      // Metro menu button — flush to left edge, solid color square
      Positioned(left: 0, top: 10,
        child: GestureDetector(
          onTap: _showRailTemp,
          child: Container(
            padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 9),
            color: gc,
            child: const Icon(Icons.menu, size: 16, color: Colors.white)))),
    ]);
  }

  Widget _buildHostDetailBody(dynamic host, Color gc) {
    final hid   = (host['hostid'] ?? '').toString();
    final hname = (host['name']   ?? host['host'] ?? 'Host').toString();
    final hip   = extractIp(host);
    final isLoading = _loadingItems[hid] == true;
    final entityMap = _entityMapForHost[hid];

    if (isLoading && (entityMap == null || entityMap.isEmpty)) {
      return Center(child: Row(mainAxisSize: MainAxisSize.min, children: [
        SizedBox(width: 14, height: 14, child: CircularProgressIndicator(strokeWidth: 1.8, color: gc)),
        const SizedBox(width: 8),
        Text('Loading…', style: TextStyle(fontSize: 11, color: gc)),
      ]));
    }
    if (entityMap == null || entityMap.isEmpty) {
      return Center(child: Text('No interfaces found', style: TextStyle(color: ZbxT.textSec(context))));
    }

    final nm  = _normalEntitiesForHost[hid] ?? {};
    final sm  = _sapEntitiesForHost[hid]    ?? {};
    final nks = nm.keys.toList()..sort();
    final sks = sm.keys.toList()..sort();

    return ListView(
      padding: const EdgeInsets.fromLTRB(0, 6, 0, 40),
      children: [
        // Metro host banner — full-width solid color
        Container(
          color: gc,
          padding: const EdgeInsets.fromLTRB(14, 11, 14, 11),
          child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
            Text(hname, style: const TextStyle(fontSize: 15, fontWeight: FontWeight.w800,
                color: Colors.white, letterSpacing: 0.2)),
            const SizedBox(height: 3),
            Text(hip, style: TextStyle(fontSize: 10,
                color: Colors.white.withValues(alpha: 0.8), fontFamily: 'monospace')),
          ]),
        ),
        const SizedBox(height: 10),

        if (sks.isNotEmpty) ...[
          InterfaceListSection(
            title: 'SAP INTERFACES',
            interfaceNames: sks,
            itemsByName: sm,
            accentColor: ZbxPalette.txGreen,
            titleColor: ZbxPalette.txGreen,
            icon: Icons.hub_outlined,
            maxItems: 12,
            overflowLabel: '+ ${sks.length - 12} more SAP interfaces',
            onTap: (ifName, items) => _openIf(
              hid: hid,
              hname: hname,
              hip: hip,
              ifName: ifName,
              items: items,
              order: sks,
              map: sm,
              isSap: true,
            ),
          ),
          const SizedBox(height: 6),
        ],

        if (nks.isNotEmpty) ...[
          InterfaceListSection(
            title: 'INTERFACES',
            interfaceNames: nks,
            itemsByName: nm,
            accentColor: gc,
            icon: Icons.settings_ethernet,
            maxItems: 20,
            overflowLabel: '+ ${nks.length - 20} more interfaces',
            onTap: (ifName, items) => _openIf(
              hid: hid,
              hname: hname,
              hip: hip,
              ifName: ifName,
              items: items,
              order: nks,
              map: nm,
            ),
          ),
        ],
      ],
    );
  }

  // ── Search view ─────────────────────────────────────────────────────────────
  Widget _buildSearch() {
    final allH    = AppCache.instance.hosts;
    final results = <Map<String, dynamic>>[];
    for (final g in _filteredGroups()) {
      final gname  = (g['name'] ?? '').toString();
      final gid    = (g['groupid'] ?? '').toString();
      final gc     = _MC.forGroupName(gname);
      final hits   = allH.where((h) {
        final gns = h['groups'] ?? h['hostgroups'];
        if (gns is! List) return false;
        if (!gns.any((gr) => (gr['name'] ?? '') == gname)) return false;
        final hid = (h['hostid'] ?? '').toString();
        return _matches('${h['name'] ?? h['host'] ?? ''} ${extractIp(h)} ${_hostMetaBlob[hid] ?? ''}');
      }).toList();
      if (hits.isNotEmpty) results.add({'group': g, 'color': gc, 'hosts': hits});
    }

    if (results.isEmpty) {
      return Center(child: Column(mainAxisSize: MainAxisSize.min, children: [
        Icon(Icons.search_off, size: 48, color: ZbxT.textSec(context).withValues(alpha: 0.4)),
        const SizedBox(height: 12),
        Text('No results for "${widget.searchQuery.trim()}"', style: TextStyle(color: ZbxT.textSec(context))),
      ]));
    }

    return ListView.builder(
      padding: const EdgeInsets.fromLTRB(0, 6, 0, 40),
      itemCount: results.length,
      itemBuilder: (_, idx) {
        final item  = results[idx];
        final g     = item['group'];
        final color = item['color'] as Color;
        final hosts = item['hosts'] as List;
        final gname = (g['name'] ?? '').toString();
        final gid   = (g['groupid'] ?? '').toString();
        return Padding(
          padding: const EdgeInsets.only(bottom: 10),
          child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
            Container(
              padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 7), color: color,
              child: Row(children: [
                Icon(Icons.folder, size: 13, color: Colors.white),
                const SizedBox(width: 6),
                Expanded(child: Text(gname, style: const TextStyle(fontSize: 12,
                    fontWeight: FontWeight.w800, color: Colors.white, letterSpacing: 0.2))),
                Text('${hosts.length} host${hosts.length > 1 ? 's' : ''}',
                  style: TextStyle(fontSize: 10, color: Colors.white.withValues(alpha: 0.8))),
              ]),
            ),
            ...hosts.map((h) => GestureDetector(
              onTap: () async {
                await _toggleGroup(gid, gname);
                if (mounted) await _toggleHost(h);
              },
              child: Container(
                margin: const EdgeInsets.only(bottom: 1),
                color: ZbxT.card(context),
                child: IntrinsicHeight(
                  child: Row(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
                    Container(width: 3, color: color.withValues(alpha: 0.45)),
                    Padding(padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 9),
                      child: Icon(Icons.dns_outlined, size: 15, color: color)),
                    Expanded(child: Padding(
                      padding: const EdgeInsets.symmetric(vertical: 9),
                      child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
                        Text((h['name'] ?? h['host'] ?? '').toString(),
                          style: TextStyle(fontSize: 13, fontWeight: FontWeight.w700,
                              color: ZbxT.textPri(context))),
                        Text(extractIp(h), style: TextStyle(fontSize: 10,
                            color: ZbxT.textSec(context), fontFamily: 'monospace')),
                      ]),
                    )),
                    Padding(padding: const EdgeInsets.symmetric(horizontal: 10),
                      child: Icon(Icons.open_in_new, size: 12,
                          color: ZbxT.textSec(context).withValues(alpha: 0.45))),
                  ]),
                ),
              ),
            )),
          ]),
        );
      },
    );
  }
}

// Arc gauge painter for fan speed cards
class _ArcGaugePainter extends CustomPainter {
  final double fraction; // 0.0-1.0
  final Color trackColor;
  final Color fillColor;

  const _ArcGaugePainter({
    required this.fraction,
    required this.trackColor,
    required this.fillColor,
  });

  @override
  void paint(Canvas canvas, Size size) {
    const startAngle = 3.14159 * 0.65; // ~117 deg
    const sweepFull = 3.14159 * 1.7; // 306 deg
    final strokeWidth = size.width * 0.09;
    final rect = Rect.fromCircle(
      center: Offset(size.width / 2, size.height / 2),
      radius: (size.width - strokeWidth) / 2,
    );
    final trackPaint = Paint()
      ..color = trackColor
      ..style = PaintingStyle.stroke
      ..strokeCap = StrokeCap.round
      ..strokeWidth = strokeWidth;
    final fillPaint = Paint()
      ..color = fillColor
      ..style = PaintingStyle.stroke
      ..strokeCap = StrokeCap.round
      ..strokeWidth = strokeWidth;
    canvas.drawArc(rect, startAngle, sweepFull, false, trackPaint);
    if (fraction > 0) {
      canvas.drawArc(rect, startAngle, sweepFull * fraction, false, fillPaint);
    }
  }

  @override
  bool shouldRepaint(_ArcGaugePainter old) =>
      old.fraction != fraction || old.trackColor != trackColor || old.fillColor != fillColor;
}

class _DualArcGaugePainter extends CustomPainter {
  final double outerFraction;
  final double innerFraction;
  final Color outerColor;
  final Color innerColor;
  final Color trackColor;

  const _DualArcGaugePainter({
    required this.outerFraction,
    required this.innerFraction,
    required this.outerColor,
    required this.innerColor,
    required this.trackColor,
  });

  @override
  void paint(Canvas canvas, Size size) {
    const startAngle = 3.14159 * 0.65;
    const sweepFull = 3.14159 * 1.7;
    final outerStroke = size.width * 0.09;
    final innerStroke = size.width * 0.06;
    final outerRect = Rect.fromCircle(
      center: Offset(size.width / 2, size.height / 2),
      radius: (size.width - outerStroke) / 2,
    );
    final innerRect = Rect.fromCircle(
      center: Offset(size.width / 2, size.height / 2),
      radius: (size.width - outerStroke) / 2 - outerStroke * 0.7,
    );
    final trackOuter = Paint()
      ..color = trackColor
      ..style = PaintingStyle.stroke
      ..strokeCap = StrokeCap.round
      ..strokeWidth = outerStroke;
    final trackInner = Paint()
      ..color = trackColor
      ..style = PaintingStyle.stroke
      ..strokeCap = StrokeCap.round
      ..strokeWidth = innerStroke;
    final outerPaint = Paint()
      ..color = outerColor
      ..style = PaintingStyle.stroke
      ..strokeCap = StrokeCap.round
      ..strokeWidth = outerStroke;
    final innerPaint = Paint()
      ..color = innerColor
      ..style = PaintingStyle.stroke
      ..strokeCap = StrokeCap.round
      ..strokeWidth = innerStroke;

    canvas.drawArc(outerRect, startAngle, sweepFull, false, trackOuter);
    canvas.drawArc(innerRect, startAngle, sweepFull, false, trackInner);
    if (outerFraction > 0) {
      canvas.drawArc(outerRect, startAngle, sweepFull * outerFraction, false, outerPaint);
    }
    if (innerFraction > 0) {
      canvas.drawArc(innerRect, startAngle, sweepFull * innerFraction, false, innerPaint);
    }
  }

  @override
  bool shouldRepaint(_DualArcGaugePainter old) =>
      old.outerFraction != outerFraction ||
      old.innerFraction != innerFraction ||
      old.outerColor != outerColor ||
      old.innerColor != innerColor ||
      old.trackColor != trackColor;
}
