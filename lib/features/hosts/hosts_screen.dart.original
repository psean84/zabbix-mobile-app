/// Metro flat list row — solid accent left bar, no rounding, no border
class _ListTileCard extends StatelessWidget {
  final IconData icon;
  final Color color;
  final String title;
  final String? subtitle;
  final int? alertCount;
  final VoidCallback onTap;

  const _ListTileCard({
    required this.icon, required this.color,
    required this.title, this.subtitle, this.alertCount,
    required this.onTap,
  });

  @override
  Widget build(BuildContext context) {
    return GestureDetector(
      onTap: onTap,
      child: Container(
        margin: const EdgeInsets.only(bottom: 2),
        color: ZbxT.card(context),
        child: IntrinsicHeight(
          child: Row(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
            // Metro left accent strip — 4 px solid, no radius
            Container(width: 4, color: color),
            Expanded(
              child: Padding(
                padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 13),
                child: Row(children: [
                  Icon(icon, color: color, size: 20),
                  const SizedBox(width: 14),
                  Expanded(
                    child: Column(crossAxisAlignment: CrossAxisAlignment.start,
                      mainAxisAlignment: MainAxisAlignment.center,
                      children: [
                      Text(title,
                        style: TextStyle(fontWeight: FontWeight.w700, fontSize: 14,
                            letterSpacing: 0.1, color: ZbxT.textPri(context))),
                      if (subtitle != null && subtitle!.isNotEmpty) ...[
                        const SizedBox(height: 2),
                        Text(subtitle!, style: TextStyle(fontSize: 10,
                            color: ZbxT.textSec(context))),
                      ],
                      if (alertCount != null && alertCount! > 0) ...[
                        const SizedBox(height: 3),
                        // Metro flat red badge — no rounding
                        Container(
                          padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 2),
                          color: ZbxPalette.downRed,
                          child: Text('$alertCount alert${alertCount! > 1 ? 's' : ''}',
                            style: const TextStyle(fontSize: 9, color: Colors.white,
                                fontWeight: FontWeight.w700))),
                      ],
                    ]),
                  ),
                  Icon(Icons.chevron_right, color: color.withValues(alpha: 0.45), size: 16),
                ]),
              ),
            ),
          ]),
        ),
      ),
    );
  }
}

/// BNG category Metro tile — solid full-color, watermark icon, bold typography
class _BngGroupTile extends StatelessWidget {
  final _BngGroup group;
  final int hostCount;
  final VoidCallback onTap;
  const _BngGroupTile({required this.group, required this.hostCount, required this.onTap});

  @override
  Widget build(BuildContext context) {
    final c = group.color;
    return GestureDetector(
      onTap: onTap,
      child: Container(
        height: 108,
        color: c,
        child: Stack(children: [
          // Watermark — large faded icon bottom-right
          Positioned(right: -12, bottom: -12,
            child: Icon(group.icon, size: 80, color: Colors.white.withValues(alpha: 0.07))),
          Padding(
            padding: const EdgeInsets.fromLTRB(14, 12, 14, 12),
            child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
              Icon(group.icon, size: 24, color: Colors.white),
              const Spacer(),
              Text(group.label, maxLines: 2, overflow: TextOverflow.ellipsis,
                style: const TextStyle(fontSize: 14, fontWeight: FontWeight.w700,
                    color: Colors.white, letterSpacing: 0.2, height: 1.15)),
              const SizedBox(height: 3),
              Text('$hostCount host${hostCount == 1 ? '' : 's'}',
                style: TextStyle(fontSize: 10, color: Colors.white.withValues(alpha: 0.75),
                    letterSpacing: 0.4)),
            ]),
          ),
        ]),
      ),
    );
  }
}

